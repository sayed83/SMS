<script language="javascript" type="text/javascript">
    $("#ddropdown").change(function () {
        var designation = $('#ddropdown').val();
        $.ajax({
            type: "POST",
            data: { id: designation },
            url: '@Url.Action("GetGridData", "Stuff")',
            success: function (result) {
                $('#partial').html(result);
            }
        });
    });
</script>
