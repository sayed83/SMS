@model MvcUMS.Models.Expandature

@{
    ViewBag.Title = "Expense";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@
@*<link href="~/Content/CSS/autocomplete.css" rel="stylesheet" />*@



<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
   @using (Html.BeginForm("Expandature", "Expance", FormMethod.Post, new 
   { 
       id = "submitForm" , @class = "form-horizontal" 
   }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Expense Details</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Expense Type:</label>
                        <div class="col-lg-9">
                           @Html.DropDownList("ExpanceType", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">

                        <label class="col-lg-3 control-label">Amount:</label>
                        <div class="col-lg-9">
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", id = "amount" })
                                <span class="input-group-addon">Tk</span>
                            </div>
                        </div>
                    </div>

                        @*<div class="form-group">
                            <label class="col-lg-3 control-label">Amount:</label>
                            <div class="col-lg-9">
                                @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", id = "amount" })Tk
                            </div>
                        </div>*@

                        <div class="form-group">
                            <label class="col-lg-3 control-label">Recipient:</label>
                            <div class="col-lg-9">
                                @Html.TextBoxFor(model => model.Recipant, new { @class = "form-control", id = "Recipient" })
                                @Html.ValidationMessageFor(model => model.Recipant)
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-lg-3 control-label">Remarks:</label>
                            <div class="col-lg-9">
                                @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", id = "remarks", placeholder = "Remarks" })
                                @Html.ValidationMessageFor(model => model.Remarks)
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-lg-3 control-label">Cash Pay:<input id="Ackbox" name="Checkbox" type="checkbox" value="false" /></label>
                            <div class="col-lg-9">

                                @Html.TextBoxFor(model => model.cashpay, new { @class = "form-control", id = "atextbox", style = "display:none" })
                                @Html.ValidationMessageFor(model => model.cashpay)
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-lg-3 control-label">Bank Pay:<input id="bpckbox" name="Checkbox" type="checkbox" value="false" /></label>
                            <div class="col-lg-9">

                                @Html.TextBoxFor(model => model.bankpay, new { @class = "form-control", id = "bankpay", style = "display:none" })
                                @Html.ValidationMessageFor(model => model.bankpay)
                            </div>
                        </div>

                        <div class="text-right">

                            <button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Submit</strong> <i class="icon-arrow-right14 position-right"></i></button>
                        </div>
                    </div>
            </div>
       
        }

        <!-- /basic layout -->

    </div>
</div>


