@section Scripts {
@*<script src="/Scripts/jquery-1.8.2.js"></script>*@

    @*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
    @*<script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@
    @*<script src="~/Scripts/combodate.js"></script>*@
    @*<script src="~/Scripts/jquery-1.8.1.js" type="text/javascript"></script>*@
    @*<script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>*@

    <script type="text/javascript">
        $(function () {
            $("#ADMtext-box,#DBTxt-box,#dobbox,#joindatetext-box").datepicker(
                {
                    dateFormat: 'yy/mm/dd',
                    changeMonth: true,
                    changeYear: true
                });
        });
    </script>

    <script type="text/javascript">
        $(function () {

            $('#amount').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;

                else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });
            $('#atextbox').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;

                else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });
            $('#bankpay').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;

                else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });

        });

        $(document).ready(function () {
            $('#Ackbox').click(function () {
                var $this = $(this);
                if ($this.is(':checked')) {
                    $('#atextbox').show();
                } else {
                    $('#atextbox').val('');
                    $('#atextbox').hide();
                }
            });
        });

        $(document).ready(function () {
            $('#bpckbox').click(function () {
                var $this = $(this);
                if ($this.is(':checked')) {
                    $('#bankpay').show();
                } else {
                    $('#bankpay').val('');
                    $('#bankpay').hide();
                }
            });
        });
        
    </script>




    @Scripts.Render("~/bundles/jqueryval")
}
