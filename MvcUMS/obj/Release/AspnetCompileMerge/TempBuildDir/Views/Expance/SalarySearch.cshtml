@{
    ViewBag.Title = "Salary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">

        <!-- Basic layout-->
        @using (Html.BeginForm("SalarySearch", "Expance", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Salary  Search</h5>
                </div>

                <div class="panel-body">
                    <span class="error-info text-semibold">@TempData["error"]</span>

                    <div class="form-inline">
                        <div class="form-group">
                            <label>Date From:</label>
                           
                                @Html.TextBox("date", null, new { @class = "form-control", id = "DaterFrom", placehoder = "Date" })
                            
                        </div>
                        <div class="form-group">
                            <label>Date To:</label>
                            @Html.TextBox("Todate", null, new { @class = "form-control", id = "DaterTo", placehoder = "Date" })
                          
                        </div>
                        <div class="form-group">
                            <button type="submit" name="Command" id="btnSearch" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>

@{
    
    Html.RenderAction("EmployeeSalaryList", "Expance", new { date = TempData["date"], Todate = TempData["Todate"] });
    
}


@section Scripts {
<script src="/Scripts/jquery-1.8.2.js"></script>
    <script type="text/javascript">

        $(function () {
            $("#DaterFrom,#DaterTo").datepicker(
           {
               dateFormat: 'yy/mm/dd',
               changeMonth: true,
               changeYear: true
           });
        });

    </script>

<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>
    @Scripts.Render("~/bundles/jqueryval")
}
