@model IEnumerable<MvcUMS.Models.expancedetailslist>
@{
    Layout = null;
}

<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
        Salary Details
        <span class="pull-right">
            @Html.ActionLink("Print", "ExpensePrint", new { fdate = TempData["date"], tdate = TempData["Todate"] }, new { @class = "btn btn-sm btn-info ", target = "_blank" })
        </span>
        </h5>
       
    </div>
    @{
        decimal Total = 0;
        decimal totalCashPay = 0;
        decimal totalBankPay = 0;
    }

    <table class="table datatable-basic">
        <thead>
            <tr>
                <th>Date</th>
                <th>Expense Type</th>
                <th>Amount</th>
                <th>Cash  Pay</th>
                <th>Bank Pay</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align:center">
                        @item.date.ToShortDateString()
                    </td>
                    <td style="text-align:center">
                        @item.payrtpe
                    </td>
                    <td style="text-align:center">
                        @item.amount
                        @{
                var totalPay = item.amount;
                Total += (decimal)totalPay;
                        }
                    </td>

                    <td style="text-align:center">
                        @item.cashamount
                        @{
                var cashPay = item.cashamount;
                totalCashPay += (decimal)cashPay;
                        }
                    </td>
                    <td style="text-align:center">
                        @item.bankpay
                        @{
                var bankPay = item.bankpay;
                totalBankPay += (decimal)bankPay;
                        }
                    </td>
                    <td>
                        @if(item.status == "Paid")
                        {
                           <span class="label bg-blue">@item.status</span>
                        }
                        else
                        {
                            <span class="label bg-danger">@item.status</span>
                        }
                             
                    </td>
                </tr>

            }

        </tbody>
        <tr>
            <td colspan="2"></td>
            <td><b>Total :@Total Tk</b></td>
            <td><b>Total :@totalCashPay Tk</b></td>
            <td><b>Total :@totalBankPay Tk</b></td>

        </tr>
    </table>

</div>





