@model PagedList.IPagedList<MvcUMS.Models.ExamType>
@using PagedList.Mvc;
@using PagedList;

@{
    Layout = null;

}

<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Exam Type List
        </h5>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Exam Type</th>
                <th>Creation Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align:center">
                        @item.Examtype
                    </td>
                    <td style="text-align:center">
                        @item.date.ToShortDateString()
                    </td>
                    <td>
                        <ul class="icons-list">
                            <li>
                                <a href='#' data-toggle='modal' class="btn btn-xs" data-target='#EditExamDialog' onclick='EditExam(@item.Id)'><i class="icon-pencil7"></i></a>
                            </li>
                            <li>
                                <a href="@Url.Action("ExamTypeDelete", new { id=item.Id })" class="btn btn-xs btn-dange" onclick="return confirm(' you want to delete?');"><i class="icon-trash"></i></a>
                            </li>
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="EditExamDialog" class="modal fade" role="dialog" style="z-index: 1600;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <div class="modal-title">Exam Type Edit</div>
            </div>
            <div class="modal-body" id="ExamPartial">

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>




<script type="text/javascript">

    function EditExam(Id) {
        $.ajax({
            type: "GET",
            data: { id: Id },
            url: '@Url.Action("EditExamType", "Common")',

            success: function (result) {
                $('#ExamPartial').html(result);

            }
        });
    }

</script>

