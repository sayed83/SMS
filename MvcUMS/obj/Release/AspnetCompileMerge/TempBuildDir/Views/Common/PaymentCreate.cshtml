@model MvcUMS.Models.ViewModels.StudentPaymentAmountViewModel

@{
    ViewBag.Title = "PaymentCreate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .error-info {
        display: inline-block;
        padding: 4px 110px;
        color: red;
    }
</style>



@{
    var message = TempData["saved"] ?? string.Empty;
}


<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("PaymentCreate", "Common", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {
               @Html.ValidationSummary(true)
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Payment Amount</h5>
                </div>

                <div class="panel-body">
                   <span class="error-info text-semibold">@TempData["error"]</span>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                            @Html.DropDownListFor(x => Model.SemesterId, ViewBag.SemesterList as SelectList, "Select", new { @class = "form-control", id = "Semester" })
                        </div>
                    </div>
                    <div class="form-group" id="group" style="display:none">
                        <label class="col-lg-3 control-label">Group:</label>
                        <div class="col-lg-9">
                            @Html.DropDownListFor(x => Model.DepartmentId, ViewBag.DepartmentList as SelectList, "Select", new { @class = "form-control", id = "department" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Type:</label>
                        <div class="col-lg-9">
                           @Html.DropDownListFor(x => Model.PaymentTypeId, ViewBag.PaymentTypeList as SelectList, "Select PaymentType", new { @class = "form-control", id = "paymenttype" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Amount:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", placeholder = "Amount", id = "text-box" })
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="pull-left">
                            <a href="@Url.Action("PaymentIndex", "Common")" class="btn btn-default">
                                <i class="icon-arrow-left13 position-left"></i>
                                <span>
                                    <strong>Back to List</strong>
                                </span>
                            </a>
                        </span>
                        <button type="submit" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>


@section Scripts {
<script src="/Scripts/jquery-1.8.2.js"></script>
<script type="text/javascript">
    $(function () {
        $('#Semester').change(function () {

            var s = $('#Semester').val();
            if (s>=12) {
                $('#group').show();
            }
            else {
                $('#group').hide();
            }

        });
    });
</script>


<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>
@Scripts.Render("~/bundles/jqueryval")
}
