@model IEnumerable<MvcUMS.Models.SchoolSetup>

    @{
        ViewBag.Title = "School List";
        Layout = "~/Views/Shared/_Layout.cshtml";
        var t = 1;
    }

    <link href="~/Content/themes/base/jquery-ui.css" rel="stylesheet" />
    @*<link href="@Url.Content("~/Content/themes/base/minified/jquery-ui.min.css")" rel="stylesheet" type="text/css" />*@
    @*<script src="@Url.Content("~/Scripts/jquery-1.7.1.min.js")" type="text/javascript"></script>*@
    <link href="~/Content/themes/base/minified/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-1.8.2.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.8.24.min.js"></script>
    @*<script src="@Url.Content("~/Scripts/jquery-ui-1.8.20.min.js")" type="text/javascript"></script>*@

    <style>
        .dataTables_length {
            float: right;
            display: inline-block;
            margin: 15px 20px 20px 20px !important;
        }

        .dataTables_filter {
            position: relative;
            display: block;
            float: left;
            margin: 15px 0 20px 20px !important;
        }

        .dataTables_info {
            float: left;
            padding: 8px 20px !important;
            margin-bottom: 20px;
        }

        .panel > .dataTables_wrapper .table-bordered {
            border-top: 1px solid #ddd !important;
            border-bottom: 1px solid #ddd !important;
            margin-bottom: 10px;
        }


        .dataTables_filter input {
            margin-left: 8px;
        }
    </style>


    <div class="panel panel-flat">

        <div class="panel-heading">
            <h5 class="panel-title">
                School List
                <span class="pull-right">@Html.ActionLink("Add New School", "SchoolCreate", null, new { @class = "btn btn-success btn-sm" })</span>
            </h5>
        </div>

        <div class="panel-body">
        </div>

        <table class="table table-bordered table-striped" id="SchoolList">
            <thead>
                <tr>
                    <th>
                        SL
                    </th>
                    <th>
                        School Name
                    </th>
                    <th>Address</th>
                    <th>
                        Actions
                    </th>
                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @t
                        </td>
                        <td>
                            @item.SchoolName

                        </td>
                        <td>
                            @item.Address,@item.City,@item.Country
                        </td>
                        <td>
                            <ul class="icons-list">
                                <li><a href='#' data-toggle='modal' class="btn btn-xs" data-target='#EditSchoolDialog' onclick='EditSchool(@item.Id)'><i class="icon-pencil7"></i></a></li>


                            </ul>

                        </td>
                    </tr>
                    t++;
                }

            </tbody>
        </table>





    </div>



    <div id="EditSchoolDialog" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>

                </div>
                <div class="modal-body" id="SchoolPartial">

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

                </div>
            </div>

        </div>
    </div>


    @{
        var message = TempData["success"] ?? string.Empty;
    }

    @section scripts{

        <script>
            $("#SchoolList").DataTable();


        </script>


        <script type="text/javascript">

        function EditSchool(Id) {
            $.ajax({
                type: "GET",
                data: { id: Id },
                url: '@Url.Action("SchoolEdit", "Common")',

                success: function (result) {
                    $('#SchoolPartial').html(result);

                }
            });
        }

        </script>



        <script type="text/javascript">
            var message = '';
            if (message)
                alert(message);
        </script>



    }





