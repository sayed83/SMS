@model IEnumerable<MvcUMS.Models.PaymentReport>
@{
    ViewBag.Title = "Payment Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var t = 1;
    decimal sum = 0;
    decimal BankTota = 0;
    decimal cashTotal = 0;
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm())
{
    <div class="form-horizontal">
        <div class="panel panel-white">
            <div class="panel-heading">
                <h5 class="panel-title">Payment  Report</h5>
            </div>

            <div class="panel-body">


                @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                <span class="error-info text-semibold">@TempData["error"]</span>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Student ID:</label>
                    <div class="col-lg-9">
                        @Html.TextBox("Std_id", null, new { @class = "form-control" })

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Class:</label>
                    <div class="col-lg-9">
                        @Html.DropDownList("Semester", null, "Select", new { @class = "form-control" })
                    </div>
                </div>


                <div class="form-group" id="group" style="display:none">
                    <label class="col-lg-3 control-label">Group:</label>
                    <div class="col-lg-9">
                        @Html.DropDownList("Department", null, "Select", new { @class = "form-control" })
                    </div>
                </div>


                <div class="form-group" id="a">
                    <label class="col-lg-3 control-label">Section:</label>
                    <div class="col-lg-9">
                        <select id="Section" name="Section" class="form-control"><option value=""></option></select>
                    </div>
                </div>

                <div class="text-right">

                    <button type="submit" name="Command" id="btnSearch" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                </div>
            </div>
        </div>
    </div>
}
        <!-- /basic layout -->

    </div>
</div>



<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Payment Report
            <span class="pull-right">@Html.ActionLink("Print", "PaymentReportPrint", new { Std_id = ViewBag.std_id, Department = ViewBag.depart, Semester = ViewBag.semes, Sec = ViewBag.Secid }, new { @class = "btn btn-info", target = "_blank" })</span>
        </h5>

    </div>
    @if(Model.Count()>0)
    { 
    <div class="table-responsive">
        <table class="table  datatable-basic">
            <thead>

                <tr>

                    <th>Date</th>
                    <th>Name</th>
                    <th>Admission</th>
                    <th>Exam</th>
                    <th>Tution</th>
                    <th>Others</th>
                    <th>Khata</th>
                    <th>Dairy</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Due</th>

                </tr>

            </thead>
            <tbody>
               @foreach (var item in Model)
                {
                    //Model.OrderByDescending(a => a.PaymentDate)
                    <tr>
                        <td>@item.PaymentDate.ToString("dd/MM/yy")</td>
                        <td>@item.studentname</td>
                        <td>
                            @item.AdmissionFee
                        </td>
                        <td>
                            @item.ExamFee
                        </td>
                        <td>
                            @item.TutionFee
                        </td>
                        <td>
                            @item.OtherFee
                        </td>
                        <td>
                            @item.Khata
                        </td>
                        <td>
                            @item.Diary
                        </td>
                        <td>
                            @{
                    var total = item.totalfees;
                    sum = sum + total;
                    //cashTotal = cashTotal + item.CashPay;
                    //BankTota = BankTota + item.BankPay;
                            }
                            @total Tk
                        </td>
                        <td>
                            @item.Payamount Tk
                        </td>
                        <td>
                            @item.Dueamount Tk
                        </td>

                    </tr>

                }
            </tbody>
        </table>
    </div>
    }
</div>


@section Scripts {
@*<script src="/Scripts/jquery-1.8.2.js"></script>
    <script src="~/Scripts/jquery-ui-1.8.24.js"></script>
    <script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@

    <script type="text/javascript">
        $(function () {
            $('#Semester').change(function () {

                var s = $('#Semester').val();
                if (s == 'Nine' || s == 'Ten' || s == 'Eleven' || s == 'Twelve') {
                    $('#group').show();
                }
                else {
                    $('#group').hide();
                }

            });

        });

        $(function () {

            $("#Std_id").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Home/getData",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Std_id, value: item.Std_id };
                            }))

                        }
                    })
                },
                messages: {
                    noResults: "", results: ""
                }
            });
        });

        $("#Semester").change(function () {
            var sem = $(this).val();
            var url = "/Home/GetCourse/";
            $.ajax({
                url: "/MasterEntry/GetSection/",
                data: { sem: sem },
                cache: false,
                type: "POST",
                success: function (data) {
                    var markup = "<option value=''>Select</option>";
                    for (var x = 0; x < data.length; x++) {
                        markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                    }
                    $("#Section").html(markup).show();
                },
                error: function (reponse) {
                    alert("error : " + reponse);
                }
            });

        });
    </script>
@Scripts.Render("~/bundles/jqueryval")
@*<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>*@
}