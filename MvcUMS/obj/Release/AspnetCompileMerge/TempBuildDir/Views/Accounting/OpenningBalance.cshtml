@model MvcUMS.Models.OpenningBalance

@{
    ViewBag.Title = "OpenningBalance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@


<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("OpenningBalance", "Accounting", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {
            @Html.ValidationSummary(true)
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Opening  Balance</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Payment Type:</label>
                        <div class="col-lg-9">
                           @Html.DropDownListFor(model => model.BalanceType, ViewBag.BalanceTypeList as SelectList, "Select", new { @class = "form-control", id = "bt" })
                        </div>
                    </div>


                    <div class="form-group" id="bid" style="display:none">
                        <label class="col-lg-3 control-label">Select Bank:</label>
                        <div class="col-lg-9">
                            @Html.DropDownListFor(model => model.BankId, ViewBag.Banklist as SelectList, "Select", new { @class = "form-control", id = "bi" })
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Amount:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", id = "amount", placeholder = "Amount" })
                            <br />
                            <input type="button" class="btn btn-primary"  name="sr1" value="Show" id="btnSubmit">
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Date:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Date, new { @class = "form-control datepicker", id = "ADMtext-box" , placeholder = "Date" })
                        </div>
                    </div>

                    <div class="text-right">
                        
                        <button type="submit" id="btnSearch" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>

