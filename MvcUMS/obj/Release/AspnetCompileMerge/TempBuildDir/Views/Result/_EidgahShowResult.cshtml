                if (examid == "") {
                    alert("No data available");
                    $('#EidgahHalfPartial').html("");
                    $('#EidgahFullPartial').html("");
                }
                else {
                    if (examid == 2) {

                        $.ajax({
                            type: "POST",
                            data: { StudentId: stdid, Semester: smtId,Section:secId, Department: dpt, Examtypeid: examid },
                            url: '@Url.Action("EidgahFullMarkSheet", "Result")',
                            cache: false,
                            dataType: "html",
                            success: function (data, textStatus, jqXHR) {
                                $("#EidgahFullPartial").html(data);
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                alert(textStatus + " - " + errorThrown);
                            }
                        });

                    }

                    else {


                        $.ajax({
                            type: "POST",
                            data: { StudentId: stdid, Semester: smtId, Section: secId, Department: dpt, Examtypeid: examid },
