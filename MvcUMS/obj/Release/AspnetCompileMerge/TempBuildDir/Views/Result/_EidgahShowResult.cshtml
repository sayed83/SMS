            $.ajax({

                type: 'POST',

                url: '@Url.Action("GetStudentrolllist")',

                dataType: 'json',

                data: { classid: $("#Semester").val() },

                success: function (Data) {
                    var markups = "<option value='0'>Select</option>";

                    for (var x = 0; x < Data.length; x++) {
                        markups += "<option Value=" + Data[x].Value + ">" + Data[x].Text + "</option>";
                    }
                    $("#StudentId").html(markups).show();
                },

                error: function (ex) {

                    alert('Failed to retrieve Department.' + ex);

                }

            });

            return false;


        });
</script>

