@model MvcUMS.Models.Marks
@{
   
    Layout = null;
}
<style>
    #exammarks, #examid
    {
        width:60%;
        height:30px;

    }

</style>
@using (Html.BeginForm("MarksDistributionUpdate", "Result", FormMethod.Post))
{
    @Html.ValidationSummary(true)

    <fieldset>

       
        @Html.HiddenFor(model => model.StudentId)
        @Html.HiddenFor(model => model.TeacherId)
        <table style="width:100%">
            <tr>
                <td style="padding:20px">Exam Type</td>
                <td>
                    @Html.DropDownListFor(model => model.ExamId, ViewBag.ExamType as SelectList, "Select", new { @class = "form-control", id = "examid" })
                </td>
            <tr>
            <tr>
                <td style="padding:20px">Mark</td>
                <td>
                    @Html.TextBoxFor(model=>model.Mark, new { @class = "form-control", id = "exammarks" })
                </td>
            </tr>
           <tr>

                <td colspan="2" style="text-align:center;padding:20px">
                    <button type="submit" id="btnUpdate" name="Command" value="Update" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                        <span class="ui-button-text">Update</span>
                    </button>
                </td>
            </tr>
            <tr>
              
                <td colspan="2">
                    @TempData["error"]
                </td>
            <tr>
              
</table>
    </fieldset>
}