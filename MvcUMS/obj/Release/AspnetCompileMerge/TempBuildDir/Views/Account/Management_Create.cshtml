@model MvcEnergyPac.Models.ManagementProfile
@{
    ViewBag.Title = "Register";
}
<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h3>Register</h3>
            </div>
            <div class="panel-body">
               @using (Html.BeginForm("Management_Create", "Account", FormMethod.Post,
                new
                {
                    enctype = "multipart/form-data"
                }))
            {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary()
                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-md-3 control-label">Name</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                                <span class="help-block"> @Html.ValidationMessageFor(a => a.Name) </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-3 control-label">Email</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                                <span class="help-block"> @Html.ValidationMessageFor(a => a.Email) </span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">Designation</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.Designation, new { @class = "form-control" })
                                <span class="help-inline"> @Html.ValidationMessageFor(a => a.Designation) </span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">Phone</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                                <span class="help-inline"> @Html.ValidationMessageFor(a => a.Phone) </span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="text-semibold col-md-3 control-label">Your avatar:</label>
                            <div class="media no-margin-top col-md-9">
                                <div class="row">
                                    <div class="col-md-5">
                                        <img src="@Url.Content("~/Content/dashboard_template/")assets/images/placeholder-small.png" id="ImgPrv" />
                                    </div>
                                    <div class="col-md-7">
                                        <div class="media-body">
                                            <div class="uploader bg-warning">
                                                <span class="filename" style="user-select: none;">@Html.TextBoxFor(model => model.image, new { @class = "file-styled", type = "file", id = "text-box", onchange = "ShowImagePreview(this);" })</span><span class="action" style="user-select: none;"><i class="icon-googleplus5"></i></span>
                                            </div>
                                            <span class="help-block">Accepted formats: gif, png, jpg. Max file size 1Mb</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @*<div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Attach Photo:</label>
                                    @Html.TextBoxFor(model => model.image, new { @class = "file-styled", type = "file", id = "text-box", onchange = "ShowImagePreview(this);" })

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Preview Photo:</label>

                                    <img src="@Url.Content("~/Content/dashboard_template/")assets/images/placeholder-small.png" id="ImgPrv" />

                                </div>
                            </div>
                        </div>*@

                        <div class="row">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit" class="btn green">Submit</button>
                            </div>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script type="text/javascript">
        
        function ShowImagePreview(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var ext = input.value.substr(input.value.lastIndexOf('.') + 1).toLowerCase();
                    if (input.files[0].size < 1048576) {
                        $("#ImgPrv").prop('src', e.target.result)
                       .width(100)
                       .height(100);
                        $("#IMGTxt").val(input.value);
                    }
                    else if (!(ext == "jpeg" || ext == "jpg" || ext == "png")) {
                        alert("Invalid image file, must select a *.jpeg, *.jpg, or *.png file.");
                    }
                    else {
                        alert("File is too large, must select file under 1 MB. File  Size: " + (input.files[0].size / 1048576).toFixed(1) + " MB");
                    }



                };
                reader.readAsDataURL(input.files[0]);
            }
        }

    </script>

    @Scripts.Render("~/bundles/jqueryval")
}
