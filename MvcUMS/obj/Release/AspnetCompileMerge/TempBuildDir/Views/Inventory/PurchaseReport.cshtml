@{
    ViewBag.Title = "PurchaseReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/themes/base/jquery-ui.css" rel="stylesheet" />*@

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("PurchaseReport", "Inventory", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Purchase  Report</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Date From:</label>
                        <div class="col-lg-9">
                           @Html.TextBox("fromdate", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Date To:</label>
                        <div class="col-lg-9">
                           @Html.TextBox("todate", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>



                    <div class="text-right">

                        <button type="submit" name="Command" id="btnSearch" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>


@{
    if (TempData["list"] != null )
    {
    
      Html.RenderAction("PurchaseList", "Inventory");

           
    }
  }
@section Scripts {
<script type="text/javascript">
    $(function () {
        $("#fromdate,#todate").datepicker(
            {
                dateFormat: 'yy/mm/dd',
                changeMonth: true,
                changeYear: true
            });
    });
</script>
    }
