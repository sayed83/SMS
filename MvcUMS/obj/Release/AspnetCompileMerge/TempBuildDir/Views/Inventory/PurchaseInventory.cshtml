@model MvcUMS.Models.Inventory
@{
    ViewBag.Title = "Inventory";
    Layout = null;
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@


<div class="modal-body">

    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Purchase</h5>

        </div>

        <div class="panel-body">



            @using (Html.BeginForm("PurchaseInventory", "Inventory", FormMethod.Post, new
            {
                @class = "form-horizontal"
            }))
            {
                @Html.ValidationSummary(true)



                   @Html.HiddenFor(model => model.Id)
                   @Html.HiddenFor(model => model.AssetTypeId)

                <div class="form-group">
                    <label class="col-lg-3 control-label">Name:</label>
                    <div class="col-lg-9">
                        @Html.DisplayFor(model => model.Name , new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Quantity:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.TotalQuantity, new { @class = "form-control", id = "tq" })
                        <span id="errmsg"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Price:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.UnitPrize, new { @class = "form-control", id = "prize" })
                        <span id="errm"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Voucher No:</label>
                    <div class="col-lg-9">
                        @Html.TextBox("BoucherNumber", null, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Purchase From:</label>
                    <div class="col-lg-9">
                        @Html.TextBox("companyname", null, new { @class = "form-control", placeholder = "Purchased From" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Purchase Date:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.date, new { @class = "form-control", id = "date" })
                    </div>
                </div>

                <div class="text-right">
                    <button type="submit" id="btnUpdate" name="Command" value="Update" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                        <span class="ui-button-text">Update</span>
                    </button>
                    @*<button type="submit" id="btnUpdate" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>*@
                </div>

               

            }
        </div>

    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>

    
     @*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
    @*<script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@
    @*<script src="~/Scripts/combodate.js"></script>*@
    @*<script src="~/Scripts/jquery-1.8.1.js" type="text/javascript"></script>*@
    @*<script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>*@
    <script type="text/javascript">
    $(function () {
        $("#date").datepicker(
            {
                dateFormat: 'yy/mm/dd',
                changeMonth: true,
                changeYear: true
            });
    });
    </script>

    <script type="text/javascript">
        $(function () {

            $('#prize').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;


                else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });
         
            $("#tq").keypress(function (e) {
                //if the letter is not digit then display error and don't type anything
                if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                    //display error message
                    $("#errmsg").html("Digits Only").show().fadeOut("slow");
                    return false;
                }


            });
        })

    </script>
}


