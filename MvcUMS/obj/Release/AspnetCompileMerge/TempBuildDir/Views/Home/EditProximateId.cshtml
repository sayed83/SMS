@model MvcUMS.Models.CurrentAcademicInfo
@{
    Layout = null;
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>
<div class="modal-body" id="SectionPartial">
    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Change Proximate ID</h5>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("EditProximateId", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
                <div class="row">

                    <div class="col-md-12 alert alert-success well">
                        @Html.HiddenFor(model => model.Std_id)
                        <table class="table table-bordered">
                            @Html.HiddenFor(x=>x.Semester)
                            @Html.HiddenFor(x=>x.Section)
                            <tr>
                                <td>Roll No:</td>
                                <td>
                                    @Html.TextBoxFor(model => model.RollNo, null, new { @class = "form-control", requred = true })
                                    @Html.ValidationMessageFor(model => model.RollNo)
                                </td>
                            </tr>
                            <tr>
                                <td>Proximate Id:</td>
                                <td>
                                    @Html.TextBoxFor(model => model.ProximateID, null, new { @class = "form-control", requred = true })
                                    @Html.ValidationMessageFor(model => model.ProximateID)
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2"><input type="submit" class="center-block" value="Update" /></td>
                            </tr>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>


