@model IEnumerable<MvcUMS.Models.PaymentList>

@{
    ViewBag.Title = "PaymentTypeView";
    Layout = null;
    var r = 1;
}
<style>
    .table {
        margin-bottom: 0!important;
    }
</style>
<table class="table table-bordered">
@foreach (var item in Model) {
    <tr>
        <td>
            @r
        </td>
        <td width="45%">
            @item.PayType @{
              if (item.PayType == "Tution Fee")
              {
                  @Html.Action("ViewTutionMonth", "Home", new { id = item.Id })                
              }
            }
        </td>
        <td>
            @item.Amount Tk
        </td>
    </tr>
    r++;
}

</table>
