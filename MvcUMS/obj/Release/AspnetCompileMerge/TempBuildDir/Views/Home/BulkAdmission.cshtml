                        <div class="form-group">
                            <label class="col-lg-3 control-label">Group:</label>
                            <div class="col-lg-9">
                                @Html.DropDownList("Department", ViewBag.Department as SelectList, "Select", new { @class = "form-control" })
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <span>@TempData["MessageError"]</span>
                        <div class="text-center">
                            <input name="FileUpload" id="FileUpload" onchange="checkfile()" type="file" accept=".csv" />
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="text-center">
