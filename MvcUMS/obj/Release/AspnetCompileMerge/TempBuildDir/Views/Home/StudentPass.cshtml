@model MvcUMS.Models.StudentPreviousAcademicInfo

@{
    ViewBag.Title = "StudentPass";
    Layout = null;
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>
<div class="modal-body" id="SectionPartial">
    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Change Current Academic Information</h5>
        </div>

        <div class="panel-body">

          @using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(a => a.Department)
    @Html.HiddenFor(a => a.Semester)
    @Html.HiddenFor(a => a.Section)
    @Html.HiddenFor(a => a.StdId)
    @Html.HiddenFor(a => a.RollNo)
    @Html.HiddenFor(a => a.Status)
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <span>Result</span>
                @Html.TextBoxFor(a => a.Result, new { @class = "form-control", placeholder = "Previous Result" })
            </div>
            <div class="form-group">
                <span>Remarks</span>
                @Html.TextAreaFor(a => a.Remarks, new { @class = "form-control", placeholder = "Remarks" })
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn-success col-md-offset-5" />
            </div>
        </div>
    </div>


}

        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>


