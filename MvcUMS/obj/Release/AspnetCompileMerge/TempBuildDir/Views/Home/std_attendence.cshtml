@{
    ViewBag.Title = "std_attendence";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        <div class="form-horizontal">

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Student  Attendance <span class="text-danger" style="font-size:14px;margin-left:20px">@TempData["Attendance_Error"]</span></h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Semester", null, "Select", new { @class = "form-control" })
                           
                        </div>
                    </div>


                    <div class="form-group" id="group" style="display:none">
                        <label class="col-lg-3 control-label">Group:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Department", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group" id="a">
                        <label class="col-lg-3 control-label">Section:</label>
                        <div class="col-lg-9">
                            <select id="Section" class="form-control"><option value=""></option></select>
                        </div>
                    </div>


                    <div class="text-right">

                        <button type="submit" id="btnSearch" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- /basic layout -->

    </div>
</div>





<div id="partial"></div>

@section Scripts {
<script src="/Scripts/jquery-1.8.2.js"></script>
<script type="text/javascript">
    $(function () {
        $('#Semester').change(function () {

            var s = $('#Semester').val();
            if (s == 'Nine' || s == 'Ten' || s == 'Eleven' || s == 'Twelve') {
                $('#group').show();
            }
            else {
                $('#group').hide();
            }

        });

    });
</script>
<script language="javascript" type="text/javascript">
   
    $("#Semester").change(function () {
        var sem = $(this).val();
        var dep = $('#Department').val();
        var url = "/Home/GetCourse/";

        $.ajax({
            url: url,
            data: { dep: dep, sem: sem },
            cache: false,
            type: "POST",
            success: function (data) {
                var markup = "<option value='0'>Select</option>";
                for (var x = 0; x < data.length; x++) {
                    markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                }
                $("#Course").html(markup).show();
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });
        
        $.ajax({
            url:"/MasterEntry/GetSection/",
            data: {sem: sem },
            cache: false,
            type: "POST",
            success: function (data) {
                var markup = "<option value=''>Select</option>";
                for (var x = 0; x < data.length; x++) {
                    markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                }
                $("#Section").html(markup).show();
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });

    });

    $("#Department").change(function () {
        var sem = $('#Semester').val();
        var dep = $(this).val();
        var url = "/Home/GetCourse/";

        $.ajax({
            url: url,
            data: { dep: dep, sem: sem },
            cache: false,
            type: "POST",
            success: function (data) {
                var markup = "<option value='0'>Select</option>";
                for (var x = 0; x < data.length; x++) {
                    markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                }
                $("#Course").html(markup).show();
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });

    });
</script>
    <script language="javascript" type="text/javascript">
        $("#btnSearch").click(function () {
            var dep = $('#Department').val();
            var sem = $('#Semester').val();
            var sec = $('#Section').val();
            //var cor = $('#Course').val();
            $.ajax({
                type: "POST",
                data: { Department: dep, Semester: sem, Section: sec },
                url: '@Url.Action("stdAttendanceList", "Home")',
                success: function (result) {
                    $('#partial').html(result);
                }
            });
        });
</script>

<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>
        @Scripts.Render("~/bundles/jqueryval")
    }

