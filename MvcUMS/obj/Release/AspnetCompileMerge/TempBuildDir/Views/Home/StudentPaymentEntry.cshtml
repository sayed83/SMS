@model MvcUMS.Models.PaymentSatup

@{
    ViewBag.Title = "StudentPaymentEntry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var t = 1;
    if (Model == null)
    {
        t = 0;
    }
}

@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@




<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title">Student Profile</h5>

    </div>

    <div class="panel-body">


        @if (Model == null)
        {
            <div class="row>">
                <div class="col-md-12">
                    @Html.Action("StudentDetailsForPayment", "Home", new { StdId = TempData["stdId"] })
                    <hr />
                </div>
            </div>

            using (Html.BeginForm("StudentPaymentEntry", "Home", FormMethod.Post))
            {
               
                <h5 class="panel-title">Student Payment Setup</h5>
                <hr />
                

                        

                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()

                        @Html.Hidden("Std_id", TempData["stdId"])

    <div class="row>">

        <div class="col-md-3">

            <div class="form-group">
                <label>Session Start Month:</label>

                @Html.TextBoxFor(a => a.SessionStartMonth, new { @class = "form-control" })

            </div>

            <div class="form-group">
                <label>Tution fee per month:</label>

                @Html.TextBoxFor(a => a.NoMonth, new { @class = "form-control Numeric isKeyprass" })

            </div>

            <div class="form-group">
                <label>Number of month:</label>

                @Html.TextBoxFor(a => a.NoMonth, new { @class = "form-control Numeric isKeyprass" })

            </div>

        </div>

        <div class="col-md-3">

            <div class="form-group">
                <label>Tution fee per month:</label>

                @Html.TextBoxFor(a => a.TutionFeePerMonth, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>

            <div class="form-group">
                <label>Lab fee:</label>

                @Html.TextBoxFor(a => a.LabFee, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>

            <div class="form-group">
                <label>Admission fee:</label>

                @Html.TextBoxFor(a => a.AdmissionFee, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>
         </div>

        <div class="col-md-3">
            <div class="form-group">
                <label>Exam fee:</label>

                @Html.TextBoxFor(a => a.ExamFee, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>



            <div class="form-group">
                <label>No of Month:</label>

                @Html.TextBoxFor(a => a.NoExam, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>

            <div class="form-group">
                <label>Total Fee:</label>

                @Html.TextBoxFor(a => a.Total, new { @class = "form-control Numeric", @Value = "0", readOnly = true })

            </div>

        </div>


        <div class="col-md-3">

          

            <div class="form-group">
                <label>Other Fee:</label>

                @Html.TextBoxFor(a => a.Other, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>

            <div class="form-group">
                <label>Library Fee:</label>

                @Html.TextBoxFor(a => a.LibraryFee, new { @class = "form-control isKeyprass Numeric", @Value = "0" })

            </div>

         
            <div class="form-group">
                
                <br />
                <button type="submit" class="btn btn-primary btn-lg">Submit <i class="icon-arrow-right14"></i></button>

            </div>

            @*<div class="text-center">
                <label>Library Fee:</label>
                <button type="submit" class="btn btn-primary">Submit <i class="icon-arrow-right14"></i></button>
            </div>*@

         </div>

               
     </div>      

            }

        }

        else
        {
            <h2 class="text-center"> Student Payment</h2>
            @Html.Action("StudentDetailsForPayment", "Home", new { StdId = Model.Std_id });
            @Html.Action("StudentPEntry", "Home", new { stp = Model });
        }



    </div>

</div>

