@{
    ViewBag.Title = "StdPaymentDetailsShow";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@

<div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title">Student Profile</h5>

    </div>

</div>


<div class="row">
    <div class="col-md-12 well">
        <h2 class="text-center">View Student Payment</h2>
        @Html.Action("StudentDetailsForPayment", "Home", new { StdId = TempData["std_id"] })
        <br />
        <table class="table table-bordered">
            <tr>
                <th style="padding-left:15%">Date From</th>
                <td>@Html.TextBox("SDate", "", new { @class = "form-control" })</td>
                <th>Date From</th>
                <td>@Html.TextBox("EDate", "", new { @class = "form-control" })</td>
                <td style="padding-right:15%"><input type="button" value="Search" class="btn btn-sm btn-success" id="btnSearch" /></td>
            </tr>
        </table>
        <div id="partial">

        </div>
    </div>
</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $('#partial').html("");
            var std_id = '@TempData["std_id"]';
            $.ajax({
                type: "POST",
                data: { stdId: std_id },
                url: '@Url.Action("StdViewPayment", "Payment")',
                success: function (result) {
                    $('#partial').html(result);
                }
            });

            @*$('#Partial2').html("");
            var std_id = '@TempData["stdid"]';
