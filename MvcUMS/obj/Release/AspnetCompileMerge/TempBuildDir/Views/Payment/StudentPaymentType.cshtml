@model List<MvcUMS.Models.ViewModels.StudentPaymentTypeViewModel>
@{
    ViewBag.Title = "StudentPaymentCallection";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}



<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">Payment Setup</h5>
    </div>

    <table class="table table-bordered">

        @for (int i = 0; i < Model.Count; i++)
                {
                <tr>
                    <td width="30%">
                        @Html.CheckBoxFor(m => m[i].IsTypeChecked, new { id = "chk_" + i, @class = "check" })
                        @Html.Label(Model[i].PaymentType)
                        @Html.HiddenFor(m => m[i].Id)
                    </td>
                    <td>
                        <div class="form-inline">
                            @Html.TextBoxFor(m => m[i].Amount, null, new { @class = "form-control TxtVal", style="width:30%", id = "txt_" + i,@readonly="readonly" })
                            @if (Model[i].PaymentType == "Monthly Fee")
                                {
                                @Html.DropDownList("noMonth", ViewBag.MonthList as IEnumerable<SelectListItem>, new { @class = "multiselect", style = "width:30%", multiple = "multiple" })
                                @Html.TextBox("MonthlyFeesToPay", null, new { @class = "form-control", style = "width:30%", @readonly = "readonly" })
                                }
                        </div>
                    </td>
                </tr>
                }
        <tr>
            <th>Total Amount</th>
            <td>
                @Html.TextBox("TotalAmount", 0, new { @class = "form-control Numeric", @readonly = "readonly" })
            </td>
        </tr>

    </table>

</div>




<script>

    $('#noMonth').multiselect();
    $("#noMonth").on('change', function () {
        var sel = $("#noMonth").val();
        $.each(sel, function (key, value) {
            var myIndex = key + 1;
            var mTotal = 0;
            mTotal = myIndex * parseInt($('#txt_0').val());
            $('#MonthlyFeesToPay').val(mTotal);
        });

    });

    var total = 0;
    $('input:checkbox').on('change', function () {
        var sum = 0;


        $('.check').each(function (i) {

            if ($("#chk_" + i).is(":checked")) {
                if (i == 0)
                    sum = sum + parseFloat($("#MonthlyFeesToPay").val());
                else
                    sum = sum + parseFloat($("#txt_" + i).val());

            }

            //if ($("#chk_" + i).is(":checked")) {

            //    sum = sum + parseFloat($("#txt_" + i).val());

            //}


        });

        $("#TotalAmount").val(sum.toFixed(2));

    });


</script>

