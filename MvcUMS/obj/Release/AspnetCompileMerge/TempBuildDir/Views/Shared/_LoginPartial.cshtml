<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/Images/cps-logo.jpg" rel="shortcut icon" type="image/x-icon" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
    @Styles.Render("~/Content/globalCss")
    @Styles.Render("~/Content/themeCss")
    <!-- /global stylesheets -->

    <!-- Core JS files -->
    @Scripts.Render("~/scripts/core")
    <!-- /core JS files -->
    <!-- Theme JS files -->
    @Scripts.Render("~/scripts/themeJs")
    
</head>

<body class="login-cover">
    <!-- Page container -->

        @RenderSection("featured", required: false)
        @RenderBody()

    @RenderSection("scripts", required: false)
</body>
</html>
