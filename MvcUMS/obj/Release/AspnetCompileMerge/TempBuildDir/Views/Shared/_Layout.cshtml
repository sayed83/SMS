                                id = "logoutForm"

                            }))
                            {
                                @Html.AntiForgeryToken()
                                <a href="javascript:document.getElementById('logoutForm').submit()"><i class="icon-switch2"></i> Sign Out</a>
                            }


                        </li>
                    </ul>
                </li>
            </ul>
        </div>
