<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/Images/cps-logo.jpg" rel="shortcut icon" type="image/x-icon" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,300,100,500,700,900" rel="stylesheet" type="text/css">
    <!-- /Style files -->
    @Styles.RenderFormat(MvcUMS.BundlesFormats.PRINT, "~/Content/globalCss")
    @Styles.RenderFormat(MvcUMS.BundlesFormats.PRINT, "~/Content/themeCss")
    @*@Styles.Render("~/Content/globalCss")
    @Styles.Render("~/Content/themeCss")*@
    <!-- /Style files -->
    <style>
        .login-dropdown li > .dropdown-menu > li:last-child {
            margin-left: 16px;
        }

