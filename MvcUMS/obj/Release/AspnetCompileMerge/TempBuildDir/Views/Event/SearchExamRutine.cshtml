@{
    ViewBag.Title = "SearchExamRutine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
       @using (Html.BeginForm("SearchExamRutine", "Event", FormMethod.Post, 
        new {
            id = "submitForm",
            @class = "form-horizontal"
        }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Search Exam Routine</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group" id="b">
                        <label class="col-lg-3 control-label">Exam Type:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("ExamType", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Semester", null, "Select", new { @class = "form-control", id = "cs" })
                        </div>
                    </div>
                    <div class="form-group" id="c" style="display:none">
                        <label class="col-lg-3 control-label">Department:</label>
                        <div class="col-lg-9">
                           @Html.DropDownList("Department", null, "Select", new { @class = "form-control", id = "cs" })
                        </div>
                    </div>
                    <div class="text-right">

                        <button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
           
        }

        <!-- /basic layout -->

    </div>
</div>


@{
    if (TempData["list"] != null)
    {


        Html.RenderAction("ListExamRoutine", "Event");


    }
   
}

@section scripts{
<script src="/Scripts/jquery-1.8.2.js"></script>
@*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
@*<script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@


    <script>

        $("#cs").change(function () {
            var sem = $(this).val();
            if (sem == 'Nine' || sem == 'Ten' || sem == 'Eleven' || sem == 'Twelve') {
                $('#c').show();
            }
            else {
                $('#c').hide();
            }
        });

    </script>

<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>
}