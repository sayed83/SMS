<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Scholarship List
            <span class="pull-right">@Html.ActionLink("Print", "ScholarshiplistPrint", new { @class = "btn btn-success" }, new { target = "_blank" })</span>
        </h5>

    </div>

 
    <table class="table" id="Scholarshiplist">
            <thead>

                <tr>

                    <th>Student ID</th>
                    <th>Type</th>
                    <th>Creation Date</th>
                    <th>Amount</th>
                    <th>Remarks</th>

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align:center">
                            @item.scholarship.StudentId
                        </td>
                        <td style="text-align:center">
                            @item.type.TypeName
                        </td>
                        <td style="text-align:center">
                            @item.scholarship.Date.ToShortDateString()
                        </td>
                        <td style="text-align:center">
                            @item.scholarship.Amount
                        </td>
                        <td style="text-align:center">
                            @item.scholarship.Remarks
                        </td>

                        @*@Html.ActionLink("View", "StudentDetails", new { id = item.scholarship.StudentId }, new { @class = "editDialog btn btn-info" })*@

                    </tr>
                }

            </tbody>
        </table>

</div>

