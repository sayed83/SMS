@model MvcUMS.Models.Book

@{
    ViewBag.Title = "CreateBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@
@*<link href="~/Content/CSS/autocomplete.css" rel="stylesheet" />*@


<div class="row">

    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
            <div style="text-align:center">
                <p style="color:red">
                    @TempData["bookid"]
                </p>
            </div>
            @using (Html.BeginForm("CreateBook", "Library", FormMethod.Post , new
                    {
                        @class = "form-horizontal"
                    }))
                    {
                        @Html.ValidationSummary(true)
                
                        <div class="panel panel-flat">
                            <div class="panel-heading">
                                <h5 class="panel-title">Create Book</h5>
                            </div>

                            <div class="panel-body">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Book ID:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.BookId, new { @class = "form-control", id = "bookid", placeholder = "Book Code" })
                                        @Html.ValidationMessageFor(model => model.BookId)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Book Name:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.BookName, new { @class = "form-control", id = "bookname", placeholder = "Book Name" })
                                        @Html.ValidationMessageFor(model => model.BookName)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Category:</label>
                                    <div class="col-lg-9">
                                        @Html.DropDownListFor(x => Model.Catagory, ViewBag.BookCatagory as SelectList, "Select", new { @class = "form-control", id = "catagory" })
                                        @Html.ValidationMessageFor(model => model.Catagory)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Author:</label>
                                    <div class="col-lg-9">
                                        @Html.DropDownListFor(x => Model.AutherId, new SelectList(string.Empty, "Value", "Text"), "Select a Author", new { @class = "form-control", id = "Auther" })
                                        @Html.ValidationMessageFor(model => model.AutherId)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">For Class:</label>
                                    <div class="col-lg-9">
                                        @Html.DropDownListFor(x => Model.ClassFor, ViewBag.Class as SelectList, "Select", new { @class = "form-control", id = "class" })
                                        @Html.ValidationMessageFor(model => model.ClassFor)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">@Html.LabelFor(model => model.ISBN):</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.ISBN, new { @class = "form-control", id = "isbn", placeholder = "ISBN Number" })
                                        @Html.ValidationMessageFor(model => model.ISBN)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Book Edition:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.BookAddition, new { @class = "form-control", id = "bookaddtion", placeholder = "Book Addtion" })
                                        @Html.ValidationMessageFor(model => model.BookAddition)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Published Date:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.PublishDate, new { @class = "form-control datepicker", id = "ADMtext-box" })
                                        @Html.ValidationMessageFor(model => model.PublishDate)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Subject:</label>
                                    <div class="col-lg-9">
                                        @Html.DropDownListFor(model => model.Subject, ViewBag.Department as SelectList, "Select", new { @class = "form-control", id = "subject" })
                                        @*@Html.TextBoxFor(model => model.Subject, new { @class = "form-control", id = "subject", placeholder = "Subject" })*@
                                        @Html.ValidationMessageFor(model => model.Subject)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Book Copy:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.BookCopy, new { @class = "form-control", id = "bookcopy", placeholder = "Number Of Book" })
                                        @Html.ValidationMessageFor(model => model.BookCopy, null, new { style = "color:red" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Unit Price:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.Price, new { @class = "form-control", id = "prize", placeholder = "Price" })
                                        @Html.ValidationMessageFor(model => model.Price, null, new { style = "color:red" })
                                    </div>
                                </div>
                                <div class="text-left">
                                    @Html.ActionLink("Back to List", "BookSearch")
                                </div>
                                <div class="text-right">
                                    <button type="submit" class="btn btn-primary">Submit Book <i class="icon-arrow-right14 position-right"></i></button>
                                </div>
                            </div>

                        </div>
                    }
        <!-- /basic layout -->

    </div>

</div>





    @section Scripts {
        @*<script src="/Scripts/jquery-1.8.2.js"></script>*@
        @*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
        @*<script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@
        @*<script src="~/Scripts/combodate.js"></script>*@
        @*<script src="~/Scripts/jquery-1.8.1.js" type="text/javascript"></script>*@
        @*<script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>*@

        <script type="text/javascript">
        //$(function () {
        //    $("#ADMtext-box").datepicker(
        //        {
        //            dateFormat: 'yy/mm/dd',
        //            changeMonth: true,
        //            changeYear: true,
        //            yearRange: "-30:+5"
        //        });
        //});

          $(function () {
                $("#ADMtext-box").datepicker(
                    {
                        dateFormat: 'yy/mm/dd',
                        changeMonth: true,
                        changeYear: true
                    });
            });

    </script>

        <script type="text/javascript">
            $(function () {

                $('#prize').keypress(function (event) {

                    if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                        return true;

                    else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                        event.preventDefault();

                });
                $('#bookcopy').keypress(function (event) {

                    if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                        return true;

                    else if (event.which != 46 && (event.which < 48 || event.which > 57))
                        event.preventDefault();

                });

              


            });


        </script>

        <script type="text/javascript">

            $(document).ready(function () {

                $("#catagory").change(function () {
                    if ($("#catagory option:selected").val() == '') {
                        $("#Auther").empty();
                        return false;
                    }
                    else {
                        //$("#city").empty();

                        $.ajax({

                            type: 'POST',

                            url: '@Url.Action("GetAuther", "Library")',

                            dataType: 'json',

                            data: { id: $("#catagory").val() },

                            success: function (Data) {

                                var markup = "<option value='0'>Select Author</option>";
                                for (var x = 0; x < Data.length; x++) {
                                    markup += "<option Value='" + Data[x].Value + "'>" + Data[x].Text + "</option>";
                                }

                                $("#Auther").html(markup).show();

                            },

                            error: function (ex) {

                                alert('Failed to retrieve Author.' + ex);

                            }

                        });
                    }

                });

            });

        </script>
        @Scripts.Render("~/bundles/jqueryval")
    }
