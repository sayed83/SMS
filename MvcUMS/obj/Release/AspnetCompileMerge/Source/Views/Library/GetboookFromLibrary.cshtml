@{
    if (TempData["list"] != null && TempData["emp"] == null)
    {
        <div class="row">

            <div class="col-md-12">
                @{
                     Html.RenderAction("GetList", "Library");
                }
            </div>
        </div>
    }
    else if (TempData["emp"] != null && TempData["list"] == null)
    {
        <div class="row">

            <div class="col-md-12">
                @{
                    Html.RenderAction("GetEmployeeList", "Library");
                }
            </div>
        </div>
    }
}

