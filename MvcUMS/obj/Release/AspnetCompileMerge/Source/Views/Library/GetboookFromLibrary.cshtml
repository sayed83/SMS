<script type="text/javascript">

    $(document).ready(function () {

        $("#BookCatagory").change(function () {
            if ($("#BookCatagory option:selected").val() == '')
            {
                $("#Auther").empty();
                return false;
            }
            else {
                //$("#city").empty();

                $.ajax({

                    type: 'POST',

                    url: '@Url.Action("GetAuther", "Library")',

                    dataType: 'json',

                    data: { id: $("#BookCatagory").val() },

                    success: function (Data) {

                        var markup = "<option value='0'>Select Auther</option>";
                        for (var x = 0; x < Data.length; x++) {
                            markup += "<option Value='" + Data[x].Value + "'>" + Data[x].Text + "</option>";
                        }

                        $("#Auther").html(markup).show();

                    },

                    error: function (ex) {

                        alert('Failed to retrieve Autheir.' + ex);

                    }

                });
            }

        });

    });

</script>


<script type="text/javascript">

    $(document).ready(function () {

        $("#Auther").change(function () {
            if ($("#Auther option:selected").val() == '')
            {
                $("#book").empty();
                return false;
            }
            else {
                //$("#city").empty();

                $.ajax({

                    type: 'POST',

                    url: '@Url.Action("GetBookId", "Library")',

                    dataType: 'json',

                    data: { id: $("#Auther").val() },

                    success: function (Data) {

                        var markup = "<option value='0'>Select Book Name</option>";
                        for (var x = 0; x < Data.length; x++) {
                            markup += "<option Value='" + Data[x].Value + "'>" + Data[x].Text + "</option>";
                        }

                        $("#book").html(markup).show();

                    },

                    error: function (ex) {

                        alert('Failed to retrieve Autheir.' + ex);

                    }

                });
            }

        });

    });

</script>

<script type="text/javascript">

    $(document).ready(function () {

        $("#book").change(function () {
            if ($("#book option:selected").val() == '')
            {
                $("#book").empty();
                return false;
            }
            else {
                //$("#city").empty();

                $.ajax({
                        url: '@Url.Action("GetBookNameAndCopy", "Library")',
                        type: 'GET',
                        cache: false,
                        data: { bookcode: $("#book").val() },
                        success: function (Data) {

                            $('#bookcode').val(Data.BookName);
                            $("#bookcode").prop('disabled', true);
                            $('#copy').val(Data.Copy + " pisces");
                            $("#copy").prop('disabled', true);

                        },
                        error: function () {
                            alert("Failed! Please try again.");

                        }
                    });
            }

        });

    });

</script>

}