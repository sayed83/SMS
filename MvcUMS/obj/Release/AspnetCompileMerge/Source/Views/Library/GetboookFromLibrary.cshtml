<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("GetboookFromLibrary", "Library", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Issued Book From Library</h5>
                </div>

                <div class="panel-body">
                    <span>@Html.Hidden("studentid", TempData["studentid"])</span>
                    <span>@TempData["text"]</span>
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Book Catagory:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("BookCatagory", null, "Select" , new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Author Name:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Auther", new SelectList(string.Empty, "Value", "Text"), "Select a Auther", new { @class = "form-control", id = "Auther" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Book ID:</label>
                        <div class="col-lg-9">
                           @Html.DropDownList("book", new SelectList(string.Empty, "Value", "Text"), "Select a BookId", new { @class = "form-control", id = "book" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Book Code:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("bookname", null, new { @class = "form-control", placeholder = "Book Code" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Sumission Date:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("Date" , null, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group" id="sid">
                        <label class="col-lg-3 control-label">Book Code:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("bookcode" ,  null, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group" id="si">
                        <label class="col-lg-3 control-label">Book Copy:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("copy", null, new { @class = "form-control" })
                           
                        </div>
                    </div>

                    <div class="text-right">
                        <button type="submit" id="btnSearch" class="btn btn-primary">Submit<i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>


