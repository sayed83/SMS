    <script>
        $(function () {
            $('#cashtextbox').change(function () {

                var s = $('#banktextbox').val();
                var t = $('#cashtextbox').val();
                var st = $('#duelable').val();
                var a = $('#amt').val();
                var sst = $('#paytextbox').val();
                var sd = $('#advancepay').val();
                var total = parseFloat(sst) - (parseFloat(t) + parseFloat(s));
                if (a > 0)
                {
                    var to = parseFloat(a) - (parseFloat(sst) - (parseFloat(t) + parseFloat(s)));
                    $('#amt').val(to);
                }
                else
                { $('#duelable').val(total); }
            
               //if (total >= parseFloat(sst))
               // {
               //     total += parseFloat(sd);
               //     $('#advancepay').val(total);
               // }

               // else
               // {
               //     total += parseFloat(st);
               //     $('#duelable').val(total);
               // }
            });

        });
        $(function () {
            $('#banktextbox').change(function () {

                var s = $('#banktextbox').val();
                var t = $('#cashtextbox').val();
                var st = $('#duelable').val();
