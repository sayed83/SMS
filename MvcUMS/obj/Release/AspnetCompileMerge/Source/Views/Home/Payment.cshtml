<div class="row">
    <div class="col-md-12">
        <h2 class="text-center">Payment</h2>
    </div>
</div>
@{
    var message = TempData["saved"] ?? string.Empty;
}



<!-- Basic layout-->

@using (Html.BeginForm("Payment", "Home", FormMethod.Post, new { @class="form-horizontal" , enctype = "multipart/form-data", target = "_blank" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
           
        <div class="panel panel-white">

            <div class="panel-heading">
                        
                <a href="#" class="btn btn-success" id="gls">Pay</a> 
                <a href="#" class="btn btn-success" id="psi">Admission</a>
               
            </div>

            <div class="panel-body">
                

                    <div id="pay">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Payment Type:</label>
                                    <div class="col-lg-9">
                                        @Html.ValidationMessageFor(model => model.TypeId)
                                        @Html.DropDownListFor(x => Model.TypeId, ViewBag.PaymentTypeList as SelectList, "Select PaymentType", new { @class = "form-control", id = "paymenttype" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                @{
                                if (@TempData["amount"] != null)
                                {
                                    var s = " Scolarship";
                            @TempData["type"] @s;
                                }
                                }
                            </div>
                            <div class="col-md-3">
                                @{
                                if (@TempData["type"] != null)
                                {
                                    var s = " Tk";
                                                        @Html.TextBox("amt", TempData["amount"], new { @readonly = "readonly" })@s;
                                }
                                }
                            </div>



                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Amount:</label>
                                    <div class="col-lg-9">
                                        @Html.ValidationMessageFor(model => model.Amount)
                                        @Html.TextBoxFor(model => model.Amount, new { @readonly = "readonly", @class = "form-control", id = "text-box" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Due Amount:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.DueAnount, new { @readonly = "readonly", @class = "form-control", id = "duelable" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="ckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:10px">Late Fine</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.fineAnount, new { @class = "form-control", id = "stextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Advance Pay:</label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.advancepay, new { @readonly = "readonly", @class = "form-control", id = "advancepay" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">Total Amount:</label>
                                    <div class="col-lg-9">
                                        @Html.ValidationMessageFor(model => model.TotalAnount)
                                        @Html.TextBoxFor(model => model.TotalAnount, new { @readonly = "readonly", @class = "form-control", id = "paytextbox" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="psinfo" style="display:none">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="Ackbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">Adminssion Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.AdmissionFee, new { @class = "form-control", id = "atextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="Dckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">Development Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.DevelopmentFee, new { @class = "form-control", id = "dtextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="Lckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">Library Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.LibraryFee, new { @class = "form-control", id = "ltextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="labckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">Lab Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.LabFee, new { @class = "form-control", id = "labtextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="trsckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">Transport Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.TransportFee, new { @class = "form-control", id = "trstextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="smsckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">SMS Fee</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.SMSAlartFee, new { @class = "form-control", id = "smstextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        Total Amount
                                    </label>
                                    <div class="col-lg-9">
                                        <input type="text" id="totaltextbox" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div id="nonam">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="cashckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">CashPay Amount</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.CashPay, new { @class = "form-control", id = "cashtextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        <input id="bankpayckbox" name="Checkbox" type="checkbox" value="false" /><b style="margin-left:5px">BankPay Amount</b>
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.BankPay, new { @class = "form-control", id = "banktextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        Remarks
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.Remarks, new { @class = "form-control", id = "remarkstextbox", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="col-lg-3 control-label">
                                        Bank Name
                                    </label>
                                    <div class="col-lg-9">
                                        @Html.TextBoxFor(model => model.bankname, new { @class = "form-control", id = "banktextboxe", style = "display: none;" })
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div id="stpay" style="display:none">
                        <div class="text-center">
                            @using (Html.BeginForm("Payment", "Home", new { id = Model.StudentId, text = 'a', target = "_blank" }))
                            {
                            <button class="btn btn-info"  type="submit">Pay</button>

                            }

                        </div>
                    </div>

                    <div id="cpay">

                        <div class="text-center">
                            <input type="submit" class="btn btn-info" value="Pay" />
                        </div>

                    </div>



           </div>

        </div>
    }

<!-- /basic layout -->



