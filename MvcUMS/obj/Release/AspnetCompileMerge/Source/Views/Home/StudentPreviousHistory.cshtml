@model IEnumerable<MvcUMS.Models.StudentPreviousAcademicInfo>

@{
    ViewBag.Title = "StudentPreviousHistory";
    Layout = null;
    int p = 1;
}

@if(Model.Count()>0)
{
    <div class="panel panel-flat">
    <div class="panel-heading">
        <h5 class="panel-title">Previous Academic History</h5>
    </div>

    <div class="panel-body">
        
    </div>

    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>SL</th>
                <th>Class</th>
                <th>Group</th>
                <th>Section</th>
                <th>Roll No</th>
                <th>Status</th>
                <th>Result</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="well">
                    <td>@p</td>
                    <td>@item.Semester</td>
                    <td>
                        @if (item.Department != null)
                        {
                            @item.Department
                        }
                        else
                        {
                            <text> N/A</text>
                        }
                    </td>
                    <td>@item.Section</td>
                    <td>@item.RollNo</td>
                    <td>@item.Status</td>
                    <td>@item.Result</td>
                    <td> @item.Remarks</td>
                </tr>
                        p++;
            }

    </tbody>
   </table>
</div>
</div>
    
    
    
}
