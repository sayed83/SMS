@model MvcUMS.Models.StudentPaytypeStudentinfo
@{
    ViewBag.Title = "Home";
    Layout = null;
}


<div class="row">
    <div class="col-lg-12">
        <!-- User thumbnail -->
        <div class="thumbnail">
            <ul class="media-list">
                <li class="media">
                    <div class="media-left media-middle">
                        <a href="#">
                            
                            <img style="width:200px;height:200px;padding:20px" src="~/uploads/@Html.DisplayFor(model => model.studentinfo.Picture)" alt="Student Image" />
                            @*<img style="width:200px;height:200px;padding:20px" src="@Url.Content("~/Content/dashboard_template/")assets/images/placeholder.jpg" alt="">*@
                        </a>
                    </div>
                    <div class="media-body" style="padding-top:20px">
                        <h4 class="text-semibold no-margin">@Model.studentinfo.Std_FName @Model.studentinfo.Std_MName @Model.studentinfo.Std_LName</h4>
                        <div class="media-heading text-semibold">Student ID: @Model.studentinfo.Std_id</div>
                        <div class="media-heading text-semibold">Class: @Model.currentacademicinfo.Semester</div>
                        <div class="media-heading text-semibold">Roll No: @Model.currentacademicinfo.RollNo</div>
                        <div class="text-left">
                           
                            @Html.ActionLink("View Profile", "StudentDetals", new { id = Model.studentinfo.Id }, new { @class = "btn bg-teal-400 btn-labeled btn-labeled-right" })
                            
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>


