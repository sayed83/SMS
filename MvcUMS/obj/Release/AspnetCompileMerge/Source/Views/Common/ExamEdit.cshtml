@model MvcUMS.Models.Exam
@{
    ViewBag.Title = "Exam";

    Layout = null;
    }
@*<link href="~/Content/themes/base/jquery-ui.css" rel="stylesheet" />*@
@*<link href="@Url.Content("~/Content/themes/base/minified/jquery-ui.min.css")" rel="stylesheet" type="text/css" />*@
@*<script src="@Url.Content("~/Scripts/jquery-1.7.1.min.js")" type="text/javascript"></script>*@
@*<script src="@Url.Content("~/Scripts/jquery-ui-1.8.20.min.js")" type="text/javascript"></script>*@

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>

<div class="modal-body">

    <div class="panel panel-white">
            <div class="panel-heading">
                <h5 class="panel-title">Edit Exam</h5>

            </div>

        <div class="panel-body">



            @using (Html.BeginForm("ExamEdit", "Common", FormMethod.Post,new{
                @class = "form-horizontal"
            }))
            {
                @Html.ValidationSummary(true)


                    
                    @Html.HiddenFor(model => model.Id)
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Course ID:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.CourseId, new { @readonly = "readonly" , @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.CourseId)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Exam Type ID:</label>
                        <div class="col-lg-9">
                            @Html.DropDownListFor(x => Model.ExamtypeId, ViewBag.ExamType as SelectList, "Select", new { @class = "form-control", id = "examlist" })
                            @Html.ValidationMessageFor(model => model.ExamtypeId)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Date:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Date, "{0:MM/dd/yyyy}", new { @class = "form-control datecontrol", id = "examd" })
                            @Html.ValidationMessageFor(model => model.Date)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Start Time:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.StartTime , new { @readonly = "readonly" , @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StartTime)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">End Time:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.EndTime , new { @readonly = "readonly" , @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.EndTime)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Type:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Type , new { @readonly = "readonly" , @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Type)
                        </div>
                    </div>
                
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Teacher:</label>
                        <div class="col-lg-9">
                            @Html.DropDownListFor(x => Model.StuffId, ViewBag.TeacherList as SelectList, "Select", new { @class = "form-control", id = "teacherlist" })
                            @Html.ValidationMessageFor(model => model.StuffId)
                        </div>
                    </div>
                
                  <div class="text-right">

                      <button type="submit" id="btnUpdate" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
                  </div>
                
                   
         
            }
        </div>
            
        </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>
       


@section Scripts {

@Scripts.Render("~/bundles/jqueryval")

}