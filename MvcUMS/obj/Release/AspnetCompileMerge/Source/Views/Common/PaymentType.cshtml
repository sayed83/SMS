@model MvcUMS.Models.ViewModels.StudentPaymentTypeViewModel


@{
    ViewBag.Title = "PaymentType";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />
<link href="~/Content/CSS/autocomplete.css" rel="stylesheet" />



@{
    var message = TempData["saved"] ?? string.Empty;
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("PaymentType", "Common", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Create Payment Type</h5>
                </div>

                <div class="panel-body">
                    <div class="form-group">
                        <label class="col-lg-3 control-label">Payment Type:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.PaymentType, new { @class = "form-control", placeholder = "Payment Type", id = "text-box" })
                            @Html.ValidationMessageFor(model => model.PaymentType)
                        </div>
                    </div>

                    <div class="text-right">
                        <span class="pull-left">
                            @*@Html.ActionLink("Back to List", "Index")*@
                            <a href="@Url.Action("Index", "Common")" class="btn btn-default">
                                <i class="icon-arrow-left13 position-left"></i>
                                <span>
                                    <strong>Back to List</strong>
                                </span>
                            </a>
                        </span>
                        <button type="submit" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
