@model IEnumerable<MvcUMS.Models.Expancetype>

@{
    ViewBag.Title = "ExpenseType List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var t = 1;
}


<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            Expense List <span style="color:red;margin-left:20px;font-size:13px">@TempData["success"] </span>
            <span class="pull-right"><a href="@Url.Action("Expacncetype","Common")" class="btn bg-slate-700">Create Expense</a></span>
        </h5>
    </div>

    <div class="panel-body">
    </div>

    <table class="table datatable-button-print-basic table-striped" id="ExpenceList">
        <thead>
            <tr class="table_header">
                <th>
                    SL
                </th>
                <th>
                    Expense Type
                </th>
                <th class="noExport">
                    Actions
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @t
                    </td>
                    <td>
                        @item.TypeName

                    </td>
                    <td>
                        <ul class="icons-list">
                            <li><a href='#' data-toggle='modal' class="btn btn-xs" data-target='#EditExpenseDialog' onclick='EditExpense(@item.Id)'><i class="icon-pencil7"></i></a></li>
                            <li>
                                <a href="@Url.Action("ExpenseDelete", new { id = item.Id })" class="btn btn-xs btn-dange" onclick="return confirm(' you want to delete?');"><i class="icon-trash"></i></a>
                            </li>

                        </ul>

                    </td>
                </tr>
                t++;
            }

        </tbody>
    </table>

</div>

<div id="EditExpenseDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>

            </div>
            <div class="modal-body" id="ExpensePartial">

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

            </div>
        </div>

    </div>
</div>

@{
    var message = TempData["success"] ?? string.Empty;
}

@section scripts{

    <script type="text/javascript">

        function EditExpense(Id) {
            $.ajax({
                type: "GET",
                data: { id: Id },
                url: '@Url.Action("ExpenseEdit", "Common")',

                success: function (result) {
                    $('#ExpensePartial').html(result);

                }
            });
        }

        $(function () {

            $('.datatable-button-print-basic').DataTable({

                buttons: [
                    {
                        extend: 'print',
                        text: '<i class="icon-printer position-left"></i> Print table',
                        className: 'btn bg-blue',
                        title: 'Expense List',
                        customize: function (win) {

                            $(win.document.body)
                                .css('font-size', '10pt')
                                .prepend(
                                    '<img src="~/Content/dashboard_template/assets/images/global-soft.-2.jpg" style="position:absolute; top:0; left:0;" />'
                                );

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        },
                        exportOptions: {
                            columns: "thead th:not(.noExport)"
                        }
                    }
                ]
            });


        });

    </script>



    <script type="text/javascript">
        var message = '';
        if (message)
            alert(message);
    </script>



}











