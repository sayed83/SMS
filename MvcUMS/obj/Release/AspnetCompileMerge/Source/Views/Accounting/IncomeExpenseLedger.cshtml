@model IEnumerable<MvcUMS.Models.incomemodel>
@{
    ViewBag.Title = "IncomeExpenseLedger";
    Layout = "~/Views/Shared/_Layout.cshtml";
 
}
<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<div class="panel panel-white">
    <div class="panel-heading text-center">
        <h3>Ledger Report</h3>
    </div>

    <div class="panel-body">
        @using (Html.BeginForm("IncomeExpenseLedger", "Accounting", FormMethod.Post))
        { 
           <div class="row">
                   <div class="col-md-3">
                       <div class="form-group">
                           <label>Form Date:</label>
                           <div class="input-group">
                               <span class="input-group-addon"><i class="icon-calendar"></i></span>

                               @Html.TextBox("fdate", null, new { @class = "form-control datepicker", placeholder = " Date From", required = true })

                           </div>

                       </div>
                   </div>


                   <div class="col-md-3">
                       <div class="form-group">
                           <label>To Date:</label>

                           <div class="input-group ">
                               <span class="input-group-addon"><i class="icon-calendar"></i></span>

                               @Html.TextBox("tdate", null, new { @class = "form-control datepicker", placeholder = " Date To",required=true })

                           </div>

                       </div>
                   </div>
               <div class="col-md-3">

                   <div class="form-group">
                       <label>    </label>
                       <div class="input-group">

                           <input type="submit" class="btn btn-primary" id="btnSearch" value="Search" />

                       </div>

                   </div>


               </div>
          </div>
        }
    </div>
    </div>


        @if (Model.Count() > 0)
        {
           <div class="panel panel-white">
             
            <div class="panel-heading">
                <h5 class="panel-title">Search Result</h5> 
                <p style="text-align:right">@Html.ActionLink("Print", "LadgerPrint", new { fdate = ViewBag.fdate, tdate = ViewBag.tdate }, new { @class = "btn btn-sm btn-info ", target = "_blank" })</p>
                <p style="text-align:right">Openning Balance: @ViewBag.openbalance Tk</p>  
            </div>
                 <table class="table datatable-basic table-bordered table-striped table-hover">
                    <thead>
                        <tr>

                            <th>Date</th>
                            <th>Particulars</th>
                            <th>Debit Amount</th>
                            <th>Credit Amount</th>
                            <th>Balance</th>


                        </tr>
                    </thead>

                    @{
                        decimal debit = 0;
                        decimal credit = 0;
                    }
                    <tbody>
                        @foreach (var item in Model.Select((x, i) => new { Data = x, Index = i + 1 }))
                        {

                            <tr>

                                <td>@item.Data.date.ToShortDateString()</td>
                                <td>@item.Data.particulars</td>
                                <td>
                                    @if (item.Data.name == "Debit")
                                    {
                                        @item.Data.totalamount

                                    }
                                    else
                                    {
                                        @credit
                                    }

                                </td>
                                <td>
                                    @if (item.Data.name == "Credit")
                                    {
                                        @item.Data.totalamount
                                    }
                                    else
                                    {
                                        @debit
                                    }

                                </td>
                                <td>
                                    @item.Data.balance
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }


        @section Scripts {

            <script type="text/javascript">
   
                    $(function () {
                        $("#fdate,#tdate").datepicker({
                            dateFormat: 'yy/mm/dd',
                            changeMonth: true,
                            changeYear: true,
                            yearRange: "-30:+90",
                           
                        } );
                    });
 
                  
            </script>
            @Scripts.Render("~/bundles/jqueryval")
        }
