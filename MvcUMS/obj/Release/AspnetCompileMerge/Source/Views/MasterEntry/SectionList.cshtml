@model IEnumerable<MvcUMS.Models.Section>

@{
    ViewBag.Title = "SectionList";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var t = 1;
}

<link href="~/Content/themes/base/jquery-ui.css" rel="stylesheet" />
<link href="@Url.Content("~/Content/themes/base/minified/jquery-ui.min.css")" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Scripts/jquery-1.7.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/jquery-ui-1.8.20.min.js")" type="text/javascript"></script>

<style>
    .dataTables_length {
        float: right;
        display: inline-block;
        margin: 15px 20px 20px 20px !important;
    }

    .dataTables_filter {
        position: relative;
        display: block;
        float: left;
        margin: 15px 0 20px 20px !important;
    }

    .dataTables_info {
        float: left;
        padding: 8px 20px !important;
        margin-bottom: 20px;
    }

    .panel > .dataTables_wrapper .table-bordered {
        border-top: 1px solid #ddd !important;
        border-bottom: 1px solid #ddd !important;
        margin-bottom: 10px;
    }


    .dataTables_filter input {
        margin-left: 8px;
    }
</style>


<div class="panel panel-flat">

    <div class="panel-heading">
        <h5 class="panel-title">
            Section List <span style="color:red;margin-left:20px;font-size:13px">@TempData["success"] </span>
            <span class="pull-right">
            <input type="button" value="Add Section" class="btn btn-sm btn-info" data-toggle="modal" data-target="#AddNewSectionDialog" id="btnAddNewClass" /></span>
        </h5>
    </div>

    <div class="panel-body">
    </div>

    <table class="table table-bordered table-striped" id="SectionList">
        <thead>
            <tr>
                <th>
                    SL
                </th>
                <th>
                    Class
                </th>
                <th>
                    Section
                </th>
                <th>
                    Actions
                </th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @t
                    </td>
                    <td>
                        @item.semester_Name 
                        @if(item.deparment_Name !=null && item.deparment_Name != "0")
                        {
                            <span>(@item.deparment_Name)</span>
                        }
                    </td>
                    <td>
                        @item.section_name
                    </td>
                    <td>
                        <ul class="icons-list">
                            <li><a href='#' data-toggle='modal' class="btn btn-xs" data-target='#EditSectionDialog' onclick='EditSection(@item.id)'><i class="icon-pencil7"></i></a></li>
                            <li>
                                <a href="@Url.Action("SectionDelete", new { id = item.id })" class="btn btn-xs btn-dange" onclick="return confirm(' you want to delete?');"><i class="icon-trash"></i></a>
                            </li>

                        </ul>

                    </td>
                </tr>
                t++;
            }

        </tbody>
    </table>


</div>

<div id="AddNewSectionDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">

                <div class="panel panel-white">
                    <div class="panel-heading">
                        <h5 class="panel-title">New Section</h5>
                    </div>

                    <div class="panel-body">

                        @using (Html.BeginForm("SectionEntry", "MasterEntry", FormMethod.Post, new
                        {
                            @class = "form-horizontal"
                        }))
                        {
                            <div class="form-group">
                                <label class="col-lg-4 control-label">Section Name:</label>
                                <div class="col-lg-8">
                                    @Html.TextBox("SectioinName", null, new { @class = "form-control", placeholder = "Section Name", required = true })
                                </div>
                            </div>
                            
                           <div class="form-group">
                                <label class="col-lg-4 control-label">Class:</label>
                                <div class="col-lg-8">
                                    @Html.DropDownList("Semester", ViewBag.Semester as SelectList, "Select", new { @class = "form-control", required = true })
                                </div>
                            </div>
                            
                             <div class="form-group" id="groupDiv">
                                <label class="col-lg-4 control-label">Department:</label>
                                <div class="col-lg-8">
                                    @Html.DropDownList("Department", ViewBag.Department as SelectList, "Select", new { @class = "form-control" })
                                </div>
                            </div>

                            <div class="text-right">
                                <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Save</strong> <i class="icon-arrow-right14 position-right"></i></button>
                            </div>

                        }
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

            </div>
        </div>

    </div>
</div>

<div id="EditSectionDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
              
            </div>
            <div class="modal-body" id="SectionPartial">

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

            </div>
        </div>

    </div>
</div>


@{
    var message = TempData["success"] ?? string.Empty;
}

@section scripts{

    <script>
        $("#SectionList").DataTable();
        $("#groupDiv").hide();
        $("#Semester").change(function () {
            var p = $(this).val();
            if (p == 'Nine' || p == 'Ten') {
                $("#groupDiv").show(100);
            }
            else {
                $("#groupDiv").hide();
            }
        })

    </script>

     
<script type="text/javascript">

 function EditSection(Id) {
    $.ajax({
        type: "GET",
        data: { id: Id },
        url: '@Url.Action("SectionEdit", "MasterEntry")',

        success: function (result) {
            $('#SectionPartial').html(result);

        }
    });
}

</script>



    <script type="text/javascript">
        var message = '';
        if (message)
            alert(message);
    </script>



}





