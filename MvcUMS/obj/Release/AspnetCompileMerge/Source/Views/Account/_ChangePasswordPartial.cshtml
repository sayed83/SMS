@model MvcEnergyPac.Models.LocalPasswordModel

@using (Html.BeginForm("Manage", "Account"))
{
    @Html.AntiForgeryToken()
    <span style="color:red">@Html.ValidationSummary()</span>
    <div class="form-horizontal">

        <div class="form-group">
            <label class="col-md-5 control-label">Current Pasword</label>
            <div class="col-md-7">
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <label class="col-md-5 control-label">New Password</label>
            <div class="col-md-7">
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <label class="col-md-5 control-label">Confirm Password</label>
            <div class="col-md-7">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-offset-5 col-md-7">
                <input type="submit" class="btn btn-success" value="Change password" />
            </div>
        </div>
    </div>
}

