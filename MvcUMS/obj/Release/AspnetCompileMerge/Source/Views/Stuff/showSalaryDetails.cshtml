@model MvcUMS.Models.StuffPaymentDetails



<div class="panel-body">

    <div class="row">

        <div class="col-md-6">

            <div class="table-responsive responsiv-table">
                <table class="table bio-table">
                    <tbody>

                        <tr>
                            <td>Designation</td>
                            <td>:@TempData["Designition"]</td>
                        </tr>
                        <tr>
                            <td>Payment Shcedule</td>
                            <td>:@TempData["PayS"]</td>
                        </tr>
                        <tr>
                            <td>Basic Salary</td>
                            <td>:@Html.DisplayFor(model => model.BasicSalary)</td>
                        </tr>
                        
                        <tr>
                            <td>Total Salary</td>
                            <td>:@Html.DisplayFor(model => model.TotalSalry)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>


        <div class="col-md-6">

            <div class="table-responsive responsiv-table">
                <table class="table bio-table">
                    <tbody>
                        <tr>
                            <td>House Rent</td>
                            <td>:@Html.DisplayFor(model => model.HouseRent)%</td>
                        </tr>
                        <tr>
                            <td>Healths</td>
                            <td>:@Html.DisplayFor(model => model.Health)%</td>
                        </tr>
                        <tr>
                            <td>Others</td>
                            <td>:@Html.DisplayFor(model => model.Others)%</td>
                        </tr>
                       




                    </tbody>
                </table>
            </div>
        </div>
    </div>
  
</div>

