<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Invenory List
            <span class="pull-right">@Html.ActionLink("New Create", "InventoryCreate", null, new { @class = "btn btn-success" })</span>
        </h5>

    </div>

     <table class="table datatable-save-state datatable-basic-employee-salary">
            <thead>

                <tr>
                    <th style="text-align:center">
                        Type
                    </th>
                    <th style="text-align:center">
                        Name
                    </th>
                    <th style="text-align:center">
                        Total Quantity
                    </th>
                    <th style="text-align:center">
                        Price
                    </th>
                    <th style="text-align:center">
                        Total Price
                    </th>
                    <th>Action</th>
                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align:center">

                            @item.IT.Name
                        </td>
                        <td style="text-align:center">

                            @item.I.Name
                        </td>
                        <td style="text-align:center">

                            @item.I.TotalQuantity
                        </td>
                        <td style="text-align:center">

                            @item.I.UnitPrize
                        </td>
                        <td style="text-align:center">
                            @{var s = @item.I.TotalQuantity * @item.I.UnitPrize;}@s
                        </td>

                        <td style="text-align:center">
                            @{
                    if (@item.I.isactive == true)
                    {
                        @Html.ActionLink("Update", "PurchaseInventory", new { id = @item.I.Id }, new { @class = "editDialog btn btn-success" ,  data_toggle="modal" , data_target="#PurchaseDialog " })
                    }

                            }

                        </td>

                    </tr>
                }

            </tbody>
        </table>

</div>

