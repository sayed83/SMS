@model MvcUMS.Models.Notice
@{
    Layout = null;
}

<style>
    .ui-datepicker{
        z-index:9999!important;
    }
</style>

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>
<div class="modal-body" id="">
    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Edit Notice</h5>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("EditNotice", "Event", FormMethod.Post, new
        {
            @class = "form-horizontal",
            enctype = "multipart/form-data"
        }))
            {
                <div class="form-group">
                    <label class="col-lg-3 control-label">Title:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.Title, new { @class = "form-control", placeholder = "Notice Title" })

                        @Html.ValidationMessageFor(model => model.Title)

                    </div>
                </div>


                <div class="form-group">
                    <label class="col-lg-3 control-label">Description:</label>
                    <div class="col-lg-9">

                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", placeholder = "Description" })
                        @Html.ValidationMessageFor(model => model.Description)

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Date:</label>

                    <div class="col-lg-9">

                        @Html.TextBoxFor(model => model.Date,"{0:dd-MM-yyyy}", new { @class = "form-control  datepicker", id = "date" })
                        @Html.ValidationMessageFor(model => model.Date)

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Notice For:</label>
                    <div class="col-lg-9">
                        @Html.DropDownListFor(model => model.NoticeFor, ViewData["noticeBoard"] as List<SelectListItem>, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.NoticeFor)
                    </div>
                </div>

                <div class="form-group">
                    <label class="text-semibold col-md-3 control-label">Your Photo:</label>
                    <div class="media no-margin-top col-md-9">
                        <div class="row">
                            <div class="col-md-5">
                                <img src="~/uploads/@Html.DisplayFor(model => model.Image)" height="130" width="100" id="ImgPrv" />
                            </div>
                            <div class="col-md-7">
                                <div class="media-body">
                                    <div class="uploader bg-warning">
                                        <span class="filename" style="user-select: none;">
                                            @Html.TextBoxFor(model => model.Image, new { id = "IMGTxt", placeholder = "Image Path", readOnly = "true" })
                                        </span>
                                        <span class="action" style="user-select: none;">
                                            @Html.TextBoxFor(model => model.picture, new { @class = "file-styled", type = "file", id = "text-box", onchange = "ShowImagePreview(this);" })<i class="icon-googleplus5"></i>
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @Html.HiddenFor(model => model.Id)
                <div class="text-right">
                    <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
                </div>

            }
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>




<script>

    $(document).ready(function () {
        $(".datepicker").datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true
        });

    });

    function ShowImagePreview(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var ext = input.value.substr(input.value.lastIndexOf('.') + 1).toLowerCase();
                if (input.files[0].size < 1048576) {
                    $("#ImgPrv").prop('src', e.target.result)
                   .width(100)
                   .height(100);
                    $("#IMGTxt").val(input.value);
                }
                else if (!(ext == "jpeg" || ext == "jpg" || ext == "png")) {
                    alert("Invalid image file, must select a *.jpeg, *.jpg, or *.png file.");
                }
                else {
                    alert("File is too large, must select file under 1 MB. File  Size: " + (input.files[0].size / 1048576).toFixed(1) + " MB");
                }



            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>