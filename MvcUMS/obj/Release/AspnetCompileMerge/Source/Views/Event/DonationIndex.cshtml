
@model List<MvcUMS.Models.Donation>

@{
    ViewBag.Title = "DonationIndex";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var grid = new WebGrid(source: Model, canPage: true, rowsPerPage: 10);
    grid.Pager(WebGridPagerModes.All);
}

<style>
    .dataTables_length {
        float: right;
        display: inline-block;
        margin: 15px 20px 20px 20px !important;
    }

    .dataTables_filter {
        position: relative;
        display: block;
        float: left;
        margin: 15px 0 20px 20px !important;
    }

    .dataTables_info {
        float: left;
        padding: 8px 20px !important;
        margin-bottom: 20px;
    }

    .panel > .dataTables_wrapper .table-bordered {
        border-top: 1px solid #ddd !important;
        border-bottom: 1px solid #ddd !important;
        margin-bottom: 10px;
    }


    .dataTables_filter input {
        margin-left: 8px;
    }
</style>


<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">Donation List
            <span class="pull-right">@Html.ActionLink("Create New", "DonationCreate", null, new { @class = " btn btn-info" })</span>
        </h5>
        
    </div>

    <table class="table table-bordered table-striped" id="donation">
            <thead>

                <tr>

                    <th>Provider Name</th>
                    <th>Recever Name</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Action</th>

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model)
                {

                    <tr>
                        <td style="text-align:center">
                            @item.ProviderName
                        </td>
                        <td style="text-align:center">
                            @item.ReciverName
                        </td>
                        <td style="text-align:center">
                            @{var s = @item.BankPay + @item.CashPay;}@s
                        </td>
                        <td style="text-align:center">
                            @item.Date.ToShortDateString()
                        </td>
                        <td>@Html.ActionLink("Edit", "DonationEdit", new { id = item.Id }, new { @class = " btn btn-info" , data_toggle="modal" , data_target="#EditDonation" })</td>

                    </tr>
                }

            </tbody>
        </table>

</div>

  <!-- Basic modal -->
<div id="EditDonation" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>

    </div>
</div>
<!-- /basic modal -->


