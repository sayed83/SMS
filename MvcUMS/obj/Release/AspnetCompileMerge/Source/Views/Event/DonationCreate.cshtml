@model MvcUMS.Models.Donation
@{
    ViewBag.Title = "Donation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@

<style>
    .check-style {
        position: relative;
        left: 60px;
    }
</style>

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("DonationCreate", "Event", FormMethod.Post, new
        {

            @class = "form-horizontal"

        }))
        {
             @Html.AntiForgeryToken()
             @Html.ValidationSummary(true)
            
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Donation Details</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Provider Name:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.ProviderName, new { @class = "form-control", placeholder = "Provider Name" })
                            @Html.ValidationMessageFor(model => model.ProviderName)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Receiver Name:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.ReciverName, new { @class = "form-control", placeholder = "Reciver Name" })

                            @Html.ValidationMessageFor(model => model.ReciverName)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Date:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Date, new { @class = "form-control", id = "date" })
                            @Html.ValidationMessageFor(model => model.Date)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Amount:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.CashPay, new { @class = "form-control", id = "cp" })
                            @Html.ValidationMessageFor(model => model.CashPay)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Bank Pay:<span class="check-style"><input id="bankpayckbox" class="styled" name="Checkbox" type="checkbox" value="false" /></span></label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.BankPay, new { @class = "form-control", id = "bp", style = "display:none" })
                        </div>
                    </div>


                    <div class="form-group" id="cn" style="display:none">
                        <label class="col-lg-3 control-label">Check No:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Checknumber, new { @class = "form-control", placeholder = "Check Number" })
                            @Html.ValidationMessageFor(model => model.Checknumber)
                        </div>
                    </div>

                    <div class="form-group" id="bn" style="display:none">
                        <label class="col-lg-3 control-label">Bank Name:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.BankName, new { @class = "form-control", placeholder = "Bank Name" })
                            @Html.ValidationMessageFor(model => model.BankName)
                        </div>
                    </div>

                    <div class="text-right">
                        <span class="pull-left">
                            @*@Html.ActionLink("Back to List", "Index")*@
                            <a href="@Url.Action("DonationIndex", "Event")" class="btn btn-default">
                                <i class="icon-arrow-left13 position-left"></i>
                                <span>
                                    <strong>Back to List</strong>
                                </span>
                            </a>
                        </span>
                        <button type="submit" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>


