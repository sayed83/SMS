@model List<MvcUMS.Models.Sp_StdAdvanceSearc_Result>

@{
    ViewBag.Title = "Student Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var grid = new WebGrid(source: Model, canPage: true, rowsPerPage: 10);
    grid.Pager(WebGridPagerModes.All);
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        <div class="form-horizontal">

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Scholarship  Report</h5>
                </div>

                <div class="panel-body">

                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Student ID:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("Std_id", null, new { @class = "form-control" })
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Semester", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group" style="display:none" id="group">
                        <label class="col-lg-3 control-label">Group:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Department", null, "Select", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Section:</label>
                        <div class="col-lg-9">
                            <select id="Section" name="Section" class="form-control"><option value=""></option></select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Roll No:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("Roll_no", null, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="text-right">
                        <span class="pull-left">
                            @*@Html.ActionLink("Back to List", "Index")*@
                            <a href="@Url.Action("ScholarshipList", "Event")" class="btn btn-default">
                                <i class="icon-arrow-left13 position-left"></i>
                                <span>
                                    <strong>Scholarship List</strong>
                                </span>
                            </a>
                        </span>
                        <button type="submit" id="btnSearch" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- /basic layout -->

    </div>
</div>




<div id="partial"></div>

<div id="dialog-edit" style="display: none">
</div>


@section Scripts {
@*<script src="/Scripts/jquery-1.8.2.js"></script>*@


@*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
@*<script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>*@

 

<script type="text/javascript">

    $(document).ready(function () {

            $('#showdata').click(function () {
                var url = $('#Modalpopup').data('url');

                $.get(url, function (data) {
                    $('#popupcontainer').html(data);

                    $('#Modalpopup').modal('show');
                });
            });

            $("#Std_id").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Home/getData",
                        type: "POST",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Std_id, value: item.Std_id };
                            }))

                        }
                    })
                },
                messages: {
                    noResults: "", results: ""
                }
            });

            $('#Semester').change(function () {

                var s = $('#Semester').val();
                if (s == 'Nine' || s == 'Ten' || s == 'Eleven' || s == 'Twelve') {
                    $('#group').show();
                }
                else {
                    $('#group').hide();
                }

            });

            $("#Semester").change(function () {
                var sem = $(this).val();
                var url = "/Home/GetCourse/";
                $.ajax({
                    url: "/MasterEntry/GetSection/",
                    data: { sem: sem },
                    cache: false,
                    type: "POST",
                    success: function (data) {
                        var markup = "<option value=''>Select</option>";
                        for (var x = 0; x < data.length; x++) {
                            markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                        }
                        $("#Section").html(markup).show();
                    },
                    error: function (reponse) {
                        alert("error : " + reponse);
                    }
                });
            });

                $('#btnSearch').click(function () {
                    var tex = $('#Std_id').val();
                    $('#partials').html("");
                    var dep = $('#Department').val();
                    var sem = $('#Semester').val();
                    var sec = $('#Section').val();
                    var roll = $("#Roll_no").val();
                    var Std_id = $("#Std_id").val();
                    $.ajax({
                        type: "POST",
                        data: { Std_id: Std_id, Department: dep, Semester: sem, Section: sec, roll: roll },
                        url: '@Url.Action("ScolarshipSearchList", "Event")',
                        success: function (result) {
                            $('#partial').html(result);
                        }
                    });
                });
   


                $(".editDialog").live("click", function (e) {
                    var url = $(this).attr('href');
                    $("#dialog-edit").dialog({
                        title: 'Scolarship Detils',
                        autoOpen: false,
                        resizable: false,
                        height: 455,
                        width: 550,
                        show: { effect: 'drop', direction: "up" },
                        modal: true,
                        draggable: true,
                        open: function (event, ui) {
                            $(this).load(url);

                        },
                        close: function (event, ui) {
                            $(this).dialog('close');
                        }
                    });

                    $("#dialog-edit").dialog('open');
                    return false;
                });

                $("#btncancel").live("click", function (e) {
                    $("#dialog-edit").dialog('close');

                });

        });
    </script>

  


    @Scripts.Render("~/bundles/jqueryval")
}