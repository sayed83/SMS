@model MvcUMS.Models.TimeShedule
@{
    ViewBag.Title = "TimeShedule Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("TimeEdit", "Event", FormMethod.Post, new
        {

            @class = "form-horizontal",
            id = "submitForm"
        }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h2 class="panel-title">Edit Time Scheduling</h2>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>




                    <div class="form-group">
                        <label class="col-lg-4 control-label">Start time:</label>
                        <div class="col-lg-8">
                            @Html.TextBoxFor(model => model.StartTime, new { @class = "form-control", id = "timetext", placeholder = "Time" })
                            @Html.ValidationMessageFor(model => model.StartTime)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-4 control-label">End Time:</label>
                        <div class="col-lg-8">
                            @Html.TextBoxFor(model => model.EndTime, new { @class = "form-control", id = "endtime", placeholder = "Time" })
                            @Html.ValidationMessageFor(model => model.EndTime)
                        </div>
                    </div>

                    <div class="text-right">

                        <button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>



@section Scripts {

    <link href="~/Scripts/src/clockpicker.css" rel="stylesheet" />
    <script src="~/Scripts/src/clockpicker.js"></script>

    <script type="text/javascript">

        $('#timetext,#endtime').clockpicker({
            placement: 'bottom',
            align: 'left',
            donetext: 'Done',
            autoclose: 'true'
        });

    </script>
}