@model MvcUMS.Models.MarkInputView
@{
    ViewBag.Title = "PaymentReports";
    Layout = null;
}

@using (Html.BeginForm("MarkStudentLists", "Result", new { CourseId = ViewBag.subject, Semester = ViewBag.semester, ExamId = ViewBag.examnameid }, FormMethod.Post))
{
    <input type="hidden" name="CourseId" id="CourseId" value="@ViewBag.subject" />
    <input type="hidden" name="ExamId" id="ExamId" value="@ViewBag.examnameid" />
    <table class="table table-xs table-bordered">
        <thead>
            <tr>
                   <th>Name</th>
                    <th>Marks</th>
                       
                
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.MarkFormViewModel)
            {
                <tr>
                    <td>@item.StudentName</td>
                    @foreach (var items in Model.MarkDetailsViewModel)
	                {
		                <td>@items.Written</td>
	                }
                </tr>
            }
        </tbody>
    </table>
