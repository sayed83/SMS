@model IEnumerable<MvcUMS.Models.ViewModels.MarksheetViewModel>
@{
    Layout = null;
}


<link href="~/Content/Custom.css" rel="stylesheet" />
<link href="~/Content/print.css" rel="stylesheet" media="print" />


<style>
    img.display-block {
        visibility: hidden;
    }

    .signature h6 {
        width: 110px;
        text-align: center;
        margin-top: 305px !important;
    }



    /*#fullmarks-hide-signature {
        display: none;
    }*/

    .col-sm-offset-1 {
        margin-left: 4.33333%;
    }

    img.eidgah-school-logo {
        display: inline;
        position: relative;
        top: 15px;
        right: 0;
        left: 70px;
    }


    .inv-signature {
       display:none;
    }

</style>



<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            MarkSheet
        </h5>
        <div class="heading-elements">
            <button type="button" id="EidgahPrintFullMarksheet" class="btn btn-default btn-xs heading-btn"><i class="icon-printer position-left"></i> Print</button>
        </div>
    </div>

    <div id="EidgahFullMarkSheetPrint">


        @foreach (var item in Model)
        {
            <div id="eidgah-body-border">
                <div class="row">
                    <div class="col-sm-1">
                        <img src="~/uploads/@item.SchoolViewModel.Logo" class="eidgah-school-logo" alt="School Logo" width="100" height="100" />
                    </div>
                    <div class="col-sm-10">
                        <div class="school-info text-center">
                            <h1 class="eidgah-school-title">

                                @item.SchoolViewModel.SchoolName
                            </h1>
                            <p class="eidgah-address">@item.SchoolViewModel.Address</p>
                            <p>@item.SchoolViewModel.City</p>
                            <h1 class="result-title">Result of Annual Examination @item?.StudentDetailsForMarksheetViewModel?.Session </h1>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-offset-2 col-sm-8 std-personal-info">
                        <table class="table table-xxs table-bordered">
                            <tbody>
                                <tr>
                                    <th>Class</th>
                                    <td>@item.StudentDetailsForMarksheetViewModel.Class</td>
                                    <th>Section</th>
                                    <td>@item.StudentDetailsForMarksheetViewModel.Section</td>
                                    <th>Group</th>
                                    <td width="10%">@item.StudentDetailsForMarksheetViewModel.Group</td>
                                    <th>Roll No</th>
                                    <td>@item.StudentDetailsForMarksheetViewModel.Roll</td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-xxs table-bordered">
                            <tbody>
                                <tr>
                                    <th width="20%">Student's Name</th>
                                    <td><strong>@item.StudentDetailsForMarksheetViewModel.Name</strong></td>
                                </tr>
                                <tr>
                                    <th width="20%">Father's Name</th>
                                    <td><strong>@item.StudentDetailsForMarksheetViewModel.FatherName</strong></td>
                                </tr>
                                <tr>
                                    <th width="20%">Mother's Name</th>
                                    <td><strong>@item.StudentDetailsForMarksheetViewModel.MotherName</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="row">
                    <div class="col-sm-10 col-sm-offset-1">
                        <h4 class="text-center eidgah-sup-title">Subject Wise Grade/Marks</h4>
                        <table class="table table-result table-xxs table-bordered table-advance">
                            <thead>

                                <tr>
                                    <th class="col-sm-2">Subject Code</th>
                                    <th class="col-sm-5">Subject Name</th>
                                    <th class="col-sm-1">Number</th>
                                    <th class="col-sm-1">Grade</th>
                                    <th class="col-sm-1">GPA</th>
                                    @*<th class="col-sm-2">Merit Position</th>*@
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var bangla = new[] { "101", "102" };
                                    var english = new[] { "107", "108" };
                                    var bm = 0m; var em = 0m;
                                    var blg = ""; var elg = "";
                                    var bgp = 0m; var egp = 0m;

                                    var clasLst = Model.Select(x => x.StudentDetailsForMarksheetViewModel.Class).FirstOrDefault();

                                    if (clasLst == "Nine" || clasLst == "Ten")
                                    {

                                        var b1passMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == "101").Select(x => x.CMS.ToList()).FirstOrDefault();

                                        var b2passMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == "102").Select(x => x.CMS.ToList()).FirstOrDefault();

                                        var BnFullMarks = item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.c.FullMarks).Sum();
                                        var EnFullMarks = item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.c.FullMarks).Sum();
                                        if (BnFullMarks == 150 || EnFullMarks == 150)
                                        {
                                            bm = (item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 1.5m);
                                            em = (item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 1.5m);
                                        }
                                        else
                                        {
                                            bm = (item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 2);
                                            em = (item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 2);
                                        }

                                        foreach (var b1p in b1passMark)
                                        {
                                            var b1WMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == b1p.CourseId).Select(x => x.ssm.Written).FirstOrDefault();
                                            var b1MMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == b1p.CourseId).Select(x => x.ssm.MCQ).FirstOrDefault();

                                            if (b1p.MarkType == "Written" && b1WMark < b1p.PassMarks)
                                            {
                                                blg = "F";
                                                bgp = 0;
                                            }
                                            else if (b1p.MarkType == "MCQ" && b1MMark < b1p.PassMarks)
                                            {
                                                blg = "F";
                                                bgp = 0;
                                            }
                                            else if ((b1p.MarkType == "Written" && b1WMark >= b1p.PassMarks) || (b1p.MarkType == "MCQ" && b1MMark >= b1p.PassMarks))
                                            {
                                                blg = MvcUMS.Models.EntityManager.ResultManager.GPAmark(bm);
                                                bgp = MvcUMS.Models.EntityManager.ResultManager.getGP(bm);
                                            }

                                        }

                                        if (blg != "F")
                                        {
                                            foreach (var b2p in b2passMark)
                                            {
                                                var b2WMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == "102").Select(x => x.ssm.Written).FirstOrDefault();
                                                var b2MMark = item.SubjectMarksCourses.Where(x => x.c.CourseId == "102").Select(x => x.ssm.MCQ).FirstOrDefault();

                                                if (b2p.MarkType == "Written" && b2WMark < b2p.PassMarks)
                                                {
                                                    blg = "F";
                                                    bgp = 0;
                                                }
                                                else if (b2p.MarkType == "MCQ" && b2MMark < b2p.PassMarks)
                                                {
                                                    blg = "F";
                                                    bgp = 0;
                                                }
                                                else if ((b2p.MarkType == "Written" && b2WMark >= b2p.PassMarks) || (b2p.MarkType == "MCQ" && b2MMark >= b2p.PassMarks))
                                                {
                                                    blg = MvcUMS.Models.EntityManager.ResultManager.GPAmark(bm);
                                                    bgp = MvcUMS.Models.EntityManager.ResultManager.getGP(bm);
                                                }

                                            }
                                        }



                                        var emPass = item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum();

                                        if (emPass >= 66)
                                        {
                                            elg = MvcUMS.Models.EntityManager.ResultManager.GPAmark(em);
                                            egp = MvcUMS.Models.EntityManager.ResultManager.getGP(em);
                                        }
                                        else
                                        {
                                            elg = "F";
                                            egp = 0;
                                        }



                                    }
                                    else
                                    {


                                        var BnFullMarks = item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.c.FullMarks).Sum();
                                        var EnFullMarks = item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.c.FullMarks).Sum();

                                        if (BnFullMarks == 150 || EnFullMarks == 150)
                                        {
                                            bm = (item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 1.5m);
                                            em = (item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 1.5m);
                                        }
                                        else
                                        {
                                            bm = (item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 2);
                                            em = (item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum() / 2);
                                        }


                                        var bmPass = item.SubjectMarksCourses.Where(x => bangla.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum();
                                        var emPass = item.SubjectMarksCourses.Where(x => english.Contains(x.c.CourseId)).Select(x => x.ssm.TotalMarks).Sum();

                                        if (bmPass >= 50)
                                        {
                                            blg = MvcUMS.Models.EntityManager.ResultManager.GPAmark(bm);
                                            bgp = MvcUMS.Models.EntityManager.ResultManager.getGP(bm);
                                        }
                                        else
                                        {
                                            blg = "F";
                                            bgp = 0;
                                        }

                                        if (emPass >= 50)
                                        {
                                            elg = MvcUMS.Models.EntityManager.ResultManager.GPAmark(em);

                                            egp = MvcUMS.Models.EntityManager.ResultManager.getGP(em);
                                        }
                                        else
                                        {
                                            elg = "F";
                                            egp = 0;
                                        }




                                    }

                                    var totalGP = 0m;
                                    int lp = 1;
                                    int subjectCount = 0;
                                    var lg = new List<string>();

                                }

                                @foreach (var calGp in item.SubjectMarksCourses)
                                {
                                    if (calGp.c.CourseId == "101")
                                    {
                                        totalGP += bgp;
                                        subjectCount++;

                                    }
                                    else if (calGp.c.CourseId == "107")
                                    {
                                        totalGP += egp;
                                        subjectCount++;
                                    }
                                    else if (calGp.c.CourseId == "102" || calGp.c.CourseId == "108")
                                    {

                                    }
                                    else if (calGp.c.ExcludeFromResult != true && calGp.c.IsOptional != true)
                                    {
                                        totalGP += calGp.ssm.GradePoint;
                                        subjectCount++;
                                    }

                                    if (calGp.c.IsOptional == true && calGp.ssm.GradePoint > 2)
                                    {
                                        totalGP += (calGp.ssm.GradePoint - 2);
                                    }

                                    lg.Add(calGp.ssm.LetterGrade);

                                }

                                @foreach (var sitem in item.SubjectMarksCourses)
                                {


                                    if (lp == 1)
                                    {
                                        <tr>
                                            <td> @sitem.c.CourseId </td>
                                            <td class="text-left">
                                                @sitem.c.CourseTitle
                                            </td>
                                            <td>
                                                @sitem.ssm.TotalMarks
                                            </td>
                                            @if (sitem.c.CourseId == "101" || sitem.c.CourseId == "107")
                                            {
                                                <td rowspan="2">
                                                    @(sitem.c.CourseId == "101" ? blg : elg)

                                                </td>
                                                <td rowspan="@item.SubjectMarksCourses.Count()">
                                                    @{




                                                        var agp = 0m;
                                                        agp = (totalGP / subjectCount);


                                                        if (item.SubjectMarksCourses.Where(x => "F".Contains(blg)).Any() == true || item.SubjectMarksCourses.Where(x => "F".Contains(elg)).Any() == true || item.SubjectMarksCourses.Where(x => lg.Contains("F")).Any() == true)
                                                        {
                                                            @("0.0")
                                                        }
                                                        else
                                                        {
                                                            if (agp >= 5)
                                                            {
                                                                @(string.Format("{0:n0}", agp))
                                                            }
                                                            else
                                                            {
                                                                @(string.Format("{0:n2}", agp))
                                                            }

                                                        }
                                                    }
                                                </td>
                                            }
                                            else if (sitem.c.CourseId == "102" || sitem.c.CourseId == "108")
                                            {

                                            }
                                            else
                                            {
                                                <td>
                                                    @sitem.ssm.LetterGrade

                                                </td>
                                                <td rowspan="@item.SubjectMarksCourses.Count()">
                                                    @{




                                                        var agp = 0m;
                                                        agp = (totalGP / subjectCount);
                                                      
                                                        if (item.SubjectMarksCourses.Where(x => lg.Contains("F")).Any() == true)
                                                        {
                                                            @("0.0")
                                                        }
                                                        else
                                                        {
                                                            @(string.Format("{0:n2}", agp))
                                                        }
                                                    }
                                                </td>
                                            }


                                            @*<td rowspan="@item.SubjectMarksCourses.Count()">
                                                    4th @sitem.TotalObMarks @totalGP
                                                </td>*@
                                        </tr>
                                    }
                                    else if (lp > 1)
                                    {
                                        <tr>
                                            <td>@sitem.c.CourseId</td>
                                            <td>
                                                @sitem.c.CourseTitle
                                            </td>
                                            <td>
                                                @sitem.ssm.TotalMarks
                                            </td>
                                            @if (sitem.c.CourseId == "101" || sitem.c.CourseId == "107")
                                            {
                                                <td rowspan="2">
                                                    @(sitem.c.CourseId == "101" ? blg : elg)

                                                </td>
                                            }
                                            else if (sitem.c.CourseId == "102" || sitem.c.CourseId == "108")
                                            {

                                            }
                                            else
                                            {
                                                <td>
                                                    @sitem.ssm.LetterGrade

                                                </td>
                                            }

                                        </tr>
                                    }

                                    lp++;


                                }


                            </tbody>
                            @*<tfoot>
                                    @{
                                        var agp = 0m;
                                        agp = (totalGP - 2) / 8;
                                    }
                                    <tr>


                                        <td>

                                            @(agp > 0 ? string.Format("{0:n2}", agp) : string.Format("{0:n0}", agp))
                                        </td>
                                    </tr>
                                </tfoot>*@
                        </table>
                    </div>
                </div>

                <div class="row inv-signature">
                    <div class="col-sm-10 col-sm-offset-1">
                        <div class="col-sm-4">
                            <div class="authorize">
                               CLASS TEACHER
                            </div>

                        </div>
                        <div class="col-sm-6">
                            <div class="authorize pull-right">
                                HEADMASTER
                            </div>
                        </div>
                    </div>
                </div>
                @*<div class="row" id="fullmarks-hide-signature">
                        <div class="col-sm-10 col-sm-offset-1">
                            <div class="signature col-sm-4">
                                <div class="content-group">

                                    <div class="mb-15 mt-15">
                                        <img src="@Url.Content("~/Content/dashboard_template")/assets/images/signature.png" class="display-block" style="width: 150px;" alt="">
                                    </div>
                                    <h6>Class Teacher</h6>
                                </div>
                            </div>
                            <div class="signature col-sm-offset-4 col-sm-4">
                                <div class="content-group">

                                    <div class="mb-15 mt-15">
                                        <img src="@Url.Content("~/Content/dashboard_template")/assets/images/signature.png" class="display-block" style="width: 150px;" alt="">
                                    </div>
                                    <h6>Headmaster</h6>
                                </div>
                            </div>

                        </div>
                    </div>*@



            </div>
            @*<p>Powered By:Zencon Technology Ltd</p>*@
            <div class="pagebreak"> </div>
        }
    </div>

</div>

<script>
    $(document).ready(function () {
        $("#EidgahPrintFullMarksheet").click(function () {
            $("#EidgahFullMarkSheetPrint").printThis();
        });
    });
</script>


