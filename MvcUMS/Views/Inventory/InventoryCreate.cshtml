@model MvcUMS.Models.Inventory
@{
    ViewBag.Title = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@
@*<style>
    #errmsg
    {
        color:red;
    }
</style>

<h2>Inventory Details</h2>*@

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("InventoryCreate", "Inventory", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.ValidationSummary(true)
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Inventory</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Stock Type:</label>
                        <div class="col-lg-9">
                           @Html.DropDownListFor(x => Model.AssetTypeId, ViewBag.TypeList as SelectList, "Select", new { @class = "form-control", id = "catagory" })
                            @Html.ValidationMessageFor(model => model.AssetTypeId)
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">@Html.LabelFor(model => model.Name):</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control", id = "name", placeholder = "Product Name" })

                            @Html.ValidationMessageFor(model => model.Name)
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Quantity:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.TotalQuantity, new { @class = "form-control", id = "tq", placeholder = "Quantity" })
                            @Html.ValidationMessageFor(model => model.TotalQuantity)
                            <span id="errmsg"></span>

                          </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Price:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.UnitPrize, new { @class = "form-control", id = "prize", placeholder = "Price" })
                            @Html.ValidationMessageFor(model => model.UnitPrize)
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Voucher No:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("BoucherNumber", null, new { @class = "form-control", placeholder = "Voucher Number" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Purchased From:</label>
                        <div class="col-lg-9">
                            @Html.TextBox("companyname", null, new { @class = "form-control", placeholder = "Purchased From" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Purchased Date:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.date, new { @class = "form-control", id = "date" })
                        </div>
                    </div>


                    <div class="text-right">
                        <span class="pull-left">
                            @*@Html.ActionLink("Back to List", "Index")*@
                            @*@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })*@
                            <a href="@Url.Action("Index", "Inventory")" class="btn btn-default">
                                <i class="icon-arrow-left13 position-left"></i>
                                <span>
                                    <strong>Back to List</strong>
                                </span>
                            </a>
                        </span>
                        <button type="submit" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }

        <!-- /basic layout -->

    </div>
</div>


