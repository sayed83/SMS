@model MvcUMS.Models.Designition
@{
    ViewBag.Title = "Section";

    Layout = null;
}



<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">Edit Designation</h5>
    </div>

    <div class="panel-body">

        @using (Html.BeginForm("DesignationEdit", "Stuff", FormMethod.Post, new
                        {
                            @class = "form-horizontal"
                        }))
        {
                <div class="form-group">
                    <label class="col-lg-4 control-label">Designation Name:</label>
                    <div class="col-lg-8">
                        @Html.TextBoxFor(m=>m.DesName, null, new { @class = "form-control", placeholder = "Desingation Name", required = true })
                    </div>
                </div>

                <div class="form-group">
                        <label class="col-lg-4 control-label">Department:</label>
                        <div class="col-lg-8">
                            @Html.DropDownListFor(m=>m.DepatmentId, ViewBag.Department as SelectList, "Select Department", new {  @class = "form-control" })
                        </div>
                </div>
            @Html.HiddenFor(model => model.DestId)
            <div class="text-right">
                <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
            </div>

        }
    </div>
</div>