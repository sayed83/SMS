@using MvcUMS.Models;
@model Tuple<List<reportlist>, List<incomelist>>
@{
    ViewBag.Title = "ReportList";
    Layout = null;
}
<style>
    #BookCatagory, #Auther {
        width: 90%;
        height: 30px;
    }


    .webgrid-table {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px;
        width: 100%;
        display: table;
        border-collapse: separate;
        border: solid 1px #ddd;
        background-color: white;
    }

        .webgrid-table td, th {
            border: 1px solid #caccc5;
            padding: 3px 7px 2px;
        }

    .webgrid-header {
        font-size: 14px;
        background-color: #bebfb9;
        color: black;
        padding-bottom: 4px;
        padding-top: 5px;
        text-align: left;
    }

    .webgrid-footer {
    }

    .webgrid-row-style {
        padding: 3px 7px 2px;
    }

    .webgrid-alternating-row {
        background-color: #EAF2D3;
        padding: 3px 7px 2px;
    }
</style>


<div class="row">
    <div class="col-md-12">
        @Html.ActionLink("Print", "DailyReportPrint", new { fdate = ViewBag.fdate, tdate = ViewBag.tdate }, new { @class = "btn btn-info", target = "_blank" })
        <table class="table table-bordered table-responsive pagesize webgrid-table " id="tablesorter">
            <tr class="webgrid-header">


                <th style="text-align:center">
                    Expense Type
                </th>

                <th style="text-align:center">
                    Amount
                </th>

            </tr>
            @{decimal total = 0;}

            @foreach (var item in Model.Item1)
            {
                <tr>
                    <td style="text-align:center">

                        @item.Name
                    </td>
                    <td style="text-align:center">
                        @{total = total + @item.Amount;}
                        @item.Amount
                    </td>

                </tr>
            }
            <tr class="webgrid-header">


                <td style="text-align:right">Total</td>
                <td style="text-align:center">@total</td>

            </tr>
        </table>
        <br />
    

    </div>
</div>

<div class="row">
    <div class="col-md-12">

        <table class="table table-bordered table-responsive pagesize webgrid-table " id="tablesorter">
            <tr class="webgrid-header">

            
                <th style="text-align:center">
                   Income Type
                </th>
               
                <th style="text-align:center">
                    Amount
                </th>

            </tr>
          @{decimal stotal = 0;}

            @foreach (var item in Model.Item2)
            {
                <tr>
                    <td style="text-align:center">

                        @item.Name
                    </td>
                    <td style="text-align:center">
                        @{stotal = stotal + @item.Amount;}
                        @item.Amount
                    </td>
         
                </tr>
            }
            <tr class="webgrid-header">


              <td style="text-align:right">Total</td>
                <td style="text-align:center">@stotal</td>

            </tr>
        </table>
        <br />
        @*Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
        @Html.PagedListPager(Model, Page_No => Url.Action("BookSearch",
                 new { Page_No, Sorting_Order = ViewBag.CurrentSortOrder, Filter_Value = ViewBag.FilterValue }))*@
     
    </div>
</div>

<div class="row" style="margin-left:300px;margin-right:30px;background-color:gray">@{ var Grandtotal = total - stotal;}Grand Total :@Grandtotal</div>