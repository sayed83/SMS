<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>

<div class="modal-body">

    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Edit donation</h5>

        </div>

        <div class="panel-body">



            @using (Html.BeginForm("DonationEdit", "Event", FormMethod.Post, new
            {
                @class = "form-horizontal"
            }))
            {
                @Html.ValidationSummary(true)



                 @Html.HiddenFor(model => model.Id)

                <div class="form-group">
                    <label class="col-lg-3 control-label">Provider Name:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.ProviderName, new { @class = "form-control", placeholder = "Provider Name" })

                        @Html.ValidationMessageFor(model => model.ProviderName)
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Receiver Name:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.ReciverName, new { @class = "form-control", placeholder = "Reciver Name" })

                         @Html.ValidationMessageFor(model => model.ReciverName)
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Date:</label>
                    <div class="col-lg-9">
                        @*@Html.TextBoxFor(model => model.Date, "{0:MM/dd/yyyy}", new { @class = "form-control datecontrol", id = "examd" })
                        @Html.ValidationMessageFor(model => model.Date)*@
                        @Html.TextBoxFor(model => model.Date, new { @class = "form-control", id = "date" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Amount:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.CashPay, new { @class = "form-control", id = "cp" })

                         @Html.ValidationMessageFor(model => model.CashPay)
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label"><input id="bankpayckbox" name="Checkbox" type="checkbox" value="false" /><b>Bank Pay</b>:</label>
                    <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.BankPay, new { @class = "form-control", id = "bp", style = "display:none" })
                    </div>
                </div>

                <div class="form-group" id="cn" style="display:none">
                    <label class="col-lg-3 control-label">Bank Name:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.BankName, new { @class = "form-control" })

                        @Html.ValidationMessageFor(model => model.BankName)
                    </div>
                </div>

                <div class="form-group" id="bn" style="display:none">
                    <label class="col-lg-3 control-label">Check Number:</label>
                    <div class="col-lg-9">
                        @Html.TextBoxFor(model => model.Checknumber, new { @class = "form-control" })

                        @Html.ValidationMessageFor(model => model.Checknumber)
                    </div>
                </div>

                <div class="text-right">

                    <button type="submit" id="btnUpdate" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
                </div>

             

            }
        </div>

    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>




