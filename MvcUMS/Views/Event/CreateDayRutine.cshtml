@model MvcUMS.Models.Rutine

@{
    ViewBag.Title = "CreateDayRutine";
    Layout = null;

    dynamic teacher = ViewBag.objdata;
}


<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>

</div>

<div class="modal-body">

    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Create Routine</h5>

        </div>

        <div class="panel-body">



            <div class="form-horizontal">



                @Html.Hidden("Semester", TempData["Class"])
                @Html.Hidden("Department", TempData["Group"])
                @Html.Hidden("Section", TempData["section"])


                @Html.Hidden("WeekId", TempData["Day"])
                @Html.Hidden("timeId", TempData["Time"])

                <div class="form-group">
                    <label class="col-lg-3 control-label">Teacher Name:</label>
                    <div class="col-lg-9">
                        @Html.DropDownListFor(a => a.TeacherId, ViewBag.objdata as SelectList, "Select", new { @class = "form-control", id = "teacher", reqiured = true })
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Subject Name:</label>
                    <div class="col-lg-9">
                        <select id="subject" class="form-control" name="SubjectTeacherId">
                            <option value="">Select</option>
                        </select>
                    </div>
                </div>

                

                <div class="text-right">

                    <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                </div>

            </div>
        </div>

    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>


<script type="text/javascript">

    $("#teacher").change(function () {
        var teacher = $(this).val();
        var day = $("#WeekId").val();
        var time = $("#timeId").val();
        $.ajax({

            type: 'GET',

            url: '@Url.Action("IsTeacherIsBusy")',

            dataType: 'json',

            data: { TeacherId: teacher, timeId: time, WeekId: day },

            success: function (Data) {
                if (Data == 0) {
                    $.ajax({

                        type: 'POST',

                        url: '@Url.Action("GetSubjectCode")',

                        dataType: 'json',

                        data: { id: $("#teacher").val(), ids: $("#Semester").val(), idd: $("#Department").val(), sec: $("#Section").val() },

                        success: function (Data) {
                            var markups = "<option value=''>Select</option>";

                            for (var x = 0; x < Data.length; x++) {
                                markups += "<option Value=" + Data[x].Value + ">" + Data[x].Text + "</option>";
                            }
                            $("#subject").html(markups).show();
                        },

                        error: function (ex) {

                            alert('Failed to retrieve Subject.' + ex);

                        }

                    });
                }
                else {
                    $("#teacher").val("")
                    alert("Your Selected Teacher is busy at this time")
                }
            },

            error: function (ex) {

                alert('Failed to retrieve Subject.' + ex);

            }

        });

        return false;

    });

    $("#btnSubmit").click(function () {
        var t = $("#teacher").val();
        var s = $("#subject").val();
        if (t == "") {
            alert("Please select teacher")
            return false;
        }
        else if (s == "") {
            alert("Please select subject")
            return false;
        }
        else {

            $('#partial').html("");
            var WeekId = $('#WeekId').val();
            var timeId = $('#timeId').val();
            var SubjectTeacherId = $('#subject').val();
            var Department = $("#Department").val();
            var Semester = $("#Semester").val();
            var Section = $("#Section").val();
            $.ajax({
                type: "POST",
                data: { WeekId: WeekId, timeId: timeId, SubjectTeacherId: SubjectTeacherId, Department: Department, Semester: Semester, Section: Section },
                url: '@Url.Action("CreateDayRutine", "Event")',
                success: function (result) {
                    $("#teacher").empty();
                    $("#subject").empty();
                    $('#partial').html(result);
                    $("#CreateDayroutineDialog").modal('hide');
                    
                }
            });
        }
    });


</script>
