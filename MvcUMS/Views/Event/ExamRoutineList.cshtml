@model PagedList.IPagedList<MvcUMS.Models.ExamRoutineView>
@using PagedList.Mvc;
@using PagedList;

@{
    Layout = null;

}

<style>
    .webgrid-table {
        font-family: "Trebuchet MS", Arial, Helvetica, sans-serif;
        font-size: 1.2em;
        width: 100%;
        display: table;
        border-collapse: separate;
        border: solid 1px #98BF21;
        background-color: white;
    }

        .webgrid-table td, th {
            border: 1px solid #98BF21;
            padding: 3px 7px 2px;
        }

    .webgrid-header {
        background-color: #A7C942;
        color: #FFFFFF;
        padding-bottom: 4px;
        padding-top: 5px;
        text-align: left;
    }

    .webgrid-footer {
    }

    .webgrid-row-style {
        padding: 3px 7px 2px;
    }

    .webgrid-alternating-row {
        background-color: #EAF2D3;
        padding: 3px 7px 2px;
    }
</style>
<div class="panel panel-flat">
    <div class="table-responsive">
        <table class="table table-striped table-bordered" cellspacing="0" width="100%" id="tablesorter" style="background-color:white">
            <tr style="background-color:#bbb795">

                <th style="text-align:center">
                    Date
                </th>
                <th style="text-align:center">
                    1st
                </th>
                <th style="text-align:center">
                    2nd
                </th>
                <th style="text-align:center">
                    3rd
                </th>

                <th style="text-align:center">
                    4th
                </th>
                <th style="text-align:center">
                    5th
                </th>
                <th style="text-align:center">
                    6th
                </th>

                <th style="text-align:center">
                    7th
                </th>

                <th style="text-align:center">
                    8th
                </th>

            </tr>

            @foreach (var item in Model)
        {

        <tr>
            <td style="text-align:center">
                @item.time
            </td>
            <td style="text-align:center">
                @item.first
            </td>
            <td style="text-align:center">
                @item.second
            </td>
            <td style="text-align:center">
                @item.third
            </td>

            <td style="text-align:center">
                @item.fourth
            </td>
            <td style="text-align:center">
                @item.fifth
            </td>
            <td style="text-align:center">
                @item.six
            </td>

            <td style="text-align:center">
                @item.seven
            </td>
            <td style="text-align:center">
                @item.eight
            </td>

        </tr>
        }

        </table>
    </div>
</div>



