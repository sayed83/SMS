@model IEnumerable<MvcUMS.Models.Sp_StdAdvanceSearc_Result>

@{
    ViewBag.Title = "ScolarshipSearchList";
    Layout = null;
    int p = 1;
}

<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
           
            
        </h5>

    </div>

    <div class="table-responsive">
        <table class="table" id="SearchScholarshipList">
            <thead>

                <tr>
                    <th>SL</th>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Father Name</th>
                    <th>Contact No</th>
                    <th>Admission Date</th>
                    <th>Class</th>
                    <th>Group</th>
                    <th>Section</th>
                    <th>Roll No</th>
                    <th>Action</th>
                </tr>

            </thead>
            <tbody>
               @foreach (var item in Model)
                {
                    <tr>
                        <td>@p</td>
                        <td>@item.Std_id</td>
                        <td>@item.Std_FName &nbsp; @item.Std_MName &nbsp; @item.Std_LName</td>
                        <td>@item.Father_Name</td>
                        <td>@item.Contact_no</td>
                        <td>@item.Admission_date.Value.ToString("dd/MM/yyyy")</td>
                        <td>@item.Semester</td>
                        <td>@item.Department</td>
                        <td>@item.Section</td>
                        <td>@item.RollNo</td>
                        <td>@Html.ActionLink("Scolarship", "ScolarShipDetail", new { id = item.Std_id }, new { @class = "btn btn-info", data_toggle = "modal", data_target = "#EditScholarship" })</td>
                    </tr>
                    p++;
                }

            </tbody>
        </table>
    </div>
</div>

  <!-- Basic modal -->
<div id="EditScholarship" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>

    </div>
</div>
<!-- /basic modal -->

