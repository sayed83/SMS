@{
    ViewBag.Title = "SearchRutine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        <div class="form-horizontal">

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Search  Routine</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group" id="ClassName">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                           @Html.DropDownList("Semester", null, "Select", new { @class = "form-control", id = "bs" })
                        </div>
                    </div>


                    <div class="form-group" id="c" style="display:none">
                        <label class="col-lg-3 control-label">Group:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Department", null, "Select", new { @class = "form-control", id = "cs" })
                        </div>
                    </div>

                    <div class="form-group" id="a">
                        <label class="col-lg-3 control-label">Section:</label>
                        <div class="col-lg-9">
                            <select id="Section" class="form-control"><option value=""></option></select>
                        </div>
                    </div>

                    

                    <div class="form-group">
                        <label class="col-lg-3 control-label">Teacher:<input id="smsckbox" name="Checkbox" type="checkbox" value="false" /></label>
                        <div class="col-lg-9">
                            
                            @Html.DropDownList("teacherid", null, "Select", new { @class = "form-control", style = "display:none", id = "tea" })
                        </div>
                    </div>

                    <div class="text-right">
                        
                        <button type="submit" id="btnSearch" class="btn bg-slate-700"><strong>Search</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- /basic layout -->

    </div>
</div>



  <!-- Basic modal -->
<div id="CreateDayroutineDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>

    </div>
</div>
<!-- /basic modal -->
    



<div id="partial"></div>


 


@section Scripts {

@*<script src="/Scripts/jquery-1.8.2.js"></script>*@
@*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>*@
@*<script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>*@



 <script type="text/javascript">
     $(document).ready(function () {

         $('#btnUpdate').on('click', function (e) {
             e.preventDefault();
             var resp = confirm("Do you want to delete this???");
             if (resp == true) {
                 $.ajax({
                     url: $(this).attr('href')
                    , success: function (response) {
                        $('#partial').html(response);
                    }
                 });
                 return false;
             }
             else {
                 return false
             }
         });

     });

     $(function () {
         $('#btnSearch').click(function () {
             $('#partial').html("");
             var dep = $('#cs').val();
             var sem = $('#bs').val();
             var sec = $('#Section').val();
             var teacherid = $("#tea").val();
             $.ajax({
                 data: { Department: dep, Semester: sem, Section: sec, teacherid: teacherid },
                 url: '@Url.Action("RotineList", "Event")',
                 success: function (result) {
                     $('#partial').html(result);
                     if (teacherid != "") {
                         $(".showEmpty").bind('click', false);
                         $(".caption").remove();
                     }
                 }
             });
         });

       
     });

     $(function () {
         $('#smsckbox').click(function () {
             var $this = $(this);
             if ($this.is(':checked')) {
                 $('#tea').show();
                 $('#a').hide();
                 $('#ClassName').hide();
                 $('#c').hide();

                 $("#Section").val('');
                 $("#bs").val('');
                 $("#cs").val('');
                 $('#partial').html("");
             }
             else {
                 $("#tea").val('')
                 $('#tea').hide();
                 $('#a').show();
                 $('#ClassName').show();
                 $('#partial').html("");
             }
         });

         $("#bs").change(function () {
             var sem = $(this).val();
             if (sem == 'Nine' || sem == 'Ten' || sem == 'Eleven' || sem == 'Twelve') {
                 $('#c').show();
             }
             else {
                 $('#c').hide();
                 $("#cs").val("")
             }
             var url = "/Home/GetCourse/";
             $.ajax({
                 url: "/MasterEntry/GetSection/",
                 data: { sem: sem },
                 cache: false,
                 type: "POST",
                 success: function (data) {
                     var markup = "<option value=''>Select</option>";
                     for (var x = 0; x < data.length; x++) {
                         markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                     }
                     $("#Section").html(markup).show();
                 },
                 error: function (reponse) {
                     alert("error : " + reponse);
                 }
             });

         });

     });

</script>

@*<script type="text/javascript" language="javascript">
    var jq = jQuery.noConflict();
</script>*@

}