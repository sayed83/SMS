@model MvcUMS.Models.Semester
@{
    ViewBag.Title = "Exam";

    Layout = null;
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
</div>
<div class="modal-body">

    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">Edit Class/Program</h5>
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("ClassEdit", "MasterEntry", FormMethod.Post, new
                        {
                            @class = "form-horizontal"
                        }))
            {
                <div class="form-group">
                    <label class="col-lg-4 control-label">Class/Program Name:</label>
                    <div class="col-lg-8">
                        @Html.TextBox("Semester_name", null, new { @class = "form-control", placeholder = "Class/Program Name", required = true })
                    </div>
                </div>

                <div class="text-right">
                    <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
                </div>

            }
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

</div>
