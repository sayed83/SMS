@model IEnumerable<MvcUMS.Models.CourseAssignList>

@{
    ViewBag.Title = "Course Assign List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<style>
  
    .btn-default:active, .btn-default.active {
        background: #455A64 !important;
        color: #fff !important;
        font-weight: bold !important;
        border-color: #ddd;
    }


    .table-bordered {
        border: 1px solid #ddd !important;
    }
      

</style>


<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
     @using (Html.BeginForm("AssignCourse", "MasterEntry", FormMethod.Post,
      new
      {
          @class = "form-horizontal"

       }))
       
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Search  Course</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Teacher Name:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("TeacherList", ViewBag.TeacherList as SelectList, "Select", new { @class = "form-control", rquired = true })
                        </div>
                    </div>


                    <div class="form-group">
                        <label class="col-lg-3 control-label">Class:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Semester", ViewBag.Semester as SelectList, "Select", new { @class = "form-control", rquired = true })
                        </div>
                    </div>

                    <div class="form-group" id="groupDiv" style="display:none">
                        <label class="col-lg-3 control-label">Group:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Department", ViewBag.Department as SelectList, "Select", new { @class = "form-control", data_bind = "value: dept" })
                        </div>
                    </div>

                    <div class="form-group" id="a">
                        <label class="col-lg-3 control-label">Section:</label>
                        <div class="col-lg-9">
                            @Html.DropDownList("Section", ViewBag.SectionList as SelectList, "Select", new { @class = "form-control", rquired = true })
                        </div>
                    </div>



                    <div class="form-group">
                        <label class="col-lg-3 control-label">Course:</label>
                        <div class="col-lg-9">
                            <select id="Course" name="Course" class="form-control" required><option value=""></option></select>
                        </div>
                    </div>

                    <div class="text-right">

                        <button type="submit" id="btnSubmit" disabled class="btn bg-slate-700"><strong>Assign</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
           
        }

        <!-- /basic layout -->

    </div>
</div>


    <div class="panel panel-white">
        <div class="panel-heading">
            <h5 class="panel-title">
               Assigned Course List
                
            </h5>

        </div>

         <table class="table table-bordered table-striped" id="MyTable">
                <thead>

                    <tr id="theadId">
                        <th>
                            Course Code
                        </th>
                        <th>
                            Course Name
                        </th>
                        <th>
                            Class
                        </th>
                        <th>
                            Section
                        </th>
                        <th>
                            Teacher Name
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.courseCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.courseName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.className)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.sectionName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.teacherName)
                            </td>
                            <td hidden>
                                @Html.DisplayFor(modelItem => item.teacherCode)
                            </td>
                            <td>
                                @Html.ActionLink("Delete", "DeleteSubjectAssign", "MasterEntry", new { id = item.Id }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('Are you sure you want to dalete?');" })
                            </td>
                        </tr>
                    }

                </tbody>
         </table>

    </div>
    
      


@section Scripts {

@*<script src="/Scripts/jquery-1.8.2.js"></script>*@

    @*<script src="~/Scripts/jquery-ui-1.8.24.min.js"></script>*@

    <script language="javascript" type="text/javascript">
        //$("#MyTable").DataTable();
     

        $(function () {
            debugger;
            $('#MyTable').after('<div id="nav"></div>');
            var rowsShown = 10;
            var rowsTotal = $('#MyTable tbody tr').length;
            var numPages = rowsTotal / rowsShown;
            for (i = 0; i < numPages; i++) {
                var pageNum = i + 1;
                $('#nav').append('<a href="#" class="btn btn-xs btn-default" rel="' + i + '">' + pageNum + '</a> ');
            }
            $('#MyTable tbody tr').hide();
            $('#MyTable tbody tr').slice(0, rowsShown).show();
            $('#nav a:first').addClass('active');
            $('#nav a').bind('click', function () {

                $('#nav a').removeClass('active');
                $(this).addClass('active');
                var currPage = $(this).attr('rel');
                var startItem = currPage * rowsShown;
                var endItem = startItem + rowsShown;
                $('#MyTable tbody tr').hide().slice(startItem, endItem).
                        css('display', 'table-row').animate({ opacity: 1 }, 300);
            });

            $("#TeacherList,#Semester,#Section,#Course").change(function () {
                var t = $("#TeacherList").val().toLowerCase();
                var s = $("#Semester").val().toLowerCase();
                var se = $("#Section").val().toLowerCase();
                var tot = 0;
                var c = $("#Course").val().toLowerCase();
                $("#MyTable tr").each(function () {
                    var t1 = $(this).find("td:nth-child(6)").text().toLowerCase();
                    var s1 = $(this).find("td:nth-child(3)").text().toLowerCase();
                    var se1 = $(this).find("td:nth-child(4)").text().toLowerCase();
                    var c1 = $(this).find("td:nth-child(1)").text().toLowerCase();
                    if (t1.indexOf(t) >= 0 && s1.indexOf(s) >= 0 && se1.indexOf(se) >= 0 && c1.indexOf(c) >= 0) {
                        $(this).show();
                        tot = tot + 1;
                    }
                    else {
                        $(this).hide();
                    }
                });
                if (tot == 0) {
                    $("#btnSubmit").attr("disabled", false)
                }
                else {
                    $("#btnSubmit").attr("disabled", true)
                }
                $("#theadId").show()
                $('#nav').html('')
                $('#p').html('<div><span>Total :' + tot + '</span></div>')
            })
        });

        debugger;
        $("#Semester").change(function () {
            var sem = $(this).val();
            var url = "/MasterEntry/GetCourse/";


            $.ajax({
                url: url,
                data: { sem: sem },
                cache: false,
                type: "POST",
                success: function (data) {
                    var markup = "<option value=''>Select</option>";
                    for (var x = 0; x < data.length; x++) {
                        markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                    }
                    $("#Course").html(markup).show();
                },
                error: function (reponse) {
                    alert("error : " + reponse);
                }
            });



            if (sem == 'Nine' || sem == 'Ten') {
                $('#groupDiv').show();
            }
            else {
                $('#groupDiv').hide();
            }

            


            $.ajax({
                url:"/MasterEntry/GetSection/",
                data: {sem: sem },
                cache: false,
                type: "POST",
                success: function (data) {
                    var markup = "<option value=''>Select</option>";
                    for (var x = 0; x < data.length; x++) {
                        markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                    }
                    $("#Section").html(markup).show();
                },
                error: function (reponse) {
                    alert("error : " + reponse);
                }
            });
        });

    </script>


    @Scripts.Render("~/bundles/jqueryval")
}