@model List<MvcUMS.Models.ViewModels.StudentListViewModel>
@{
    ViewBag.Title = "StudentPaymentCallection";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}

<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">Student List</h5>
    </div>
    <table class="table table-striped table-bordered table-hover" id="datatable_reviews">
        <thead>
            <tr role="row" class="heading">

                <th>StdID</th>
                <th> Student Name</th>
                <th><input type="checkbox" id="checkAll">Select All</th>
            </tr>

        </thead>
        <tbody>

            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>

                    <td style="text-align:center">
                        @Html.DisplayFor(model => model[i].StdId)
                        @Html.HiddenFor(model => model[i].Name)
                        @Html.HiddenFor(model => model[i].StudentId)
                        @Html.HiddenFor(model => model[i].SemesterId)
                    </td>
                    <td style="text-align:center">
                        @Html.DisplayFor(model => model[i].Name)
                    </td>
                    <td>
                        @Html.CheckBoxFor(m => m[i].IsChecked, new { id = "pro_" + Model[i].StdId, @class = "stdId" })
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<script>
    $(document).ready(function () {
        $("#checkAll").click(function () {
            $('input.stdId:checkbox').not(this).prop('checked', this.checked);
        });
    });
</script>

