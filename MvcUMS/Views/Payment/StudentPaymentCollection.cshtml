@model List<MvcUMS.Models.PaymentTypeViewModel>
@{
    ViewBag.Title = "StudentPaymentCallection";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}


<div class="row">
    <div class="col-md-12">
        <div class="portlet light bordered">

            <div class="portlet-body form">

                @using (Html.BeginForm("StudentPaymentCollection", "Payment", FormMethod.Post))
                {

                    <div class="form-horizontal">
                        <input type="hidden" name="StudentId" value="@ViewBag.StudentId" />

                        <table class="table table-bordered">

                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Html.CheckBoxFor(m => m[i].IsChecked, new { id = "chk_" + i, @class = "check" })


                                        @Html.Label(Model[i].PaymentType)

                                        @Html.HiddenFor(m => m[i].Id)
                                    </td>
                                    <td>
                                        <div class="form-inline">
                                            @Html.TextBoxFor(m => m[i].Amount, null, new { @class = "form-control TxtVal", id = "txt_" + i })
                                            @if (Model[i].PaymentType == "Monthly Fee")
                                            {
                                                @Html.DropDownList("noMonth", ViewBag.MonthList as IEnumerable<SelectListItem>, new { @class = "multiselect", multiple = "multiple" })
                                                @Html.TextBox("MonthlyFeesToPay", null, new { @class = "form-control" })
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <th>Total Amount</th>
                                <td>
                                    @Html.TextBox("TotalAmount", 0, new { @class = "form-control Numeric" })
                                </td>
                            </tr>
                            <tr>
                                <th>Payable</th>
                                <td>
                                    @Html.TextBox("TotalSemesterFees", 0, new { @class = "form-control Numeric" })
                                </td>
                            </tr>

                            <tr id="cashDiv">
                                <th>Total Payment</th>
                                <td> @Html.TextBox("PaidAmount", 0, new { @class = "form-control Numeric InvQty", id = "InvQty1" })</td>
                            </tr>
                            <tr>
                                <th>Due Amount</th>
                                <td> @Html.TextBox("Due", null, new { @class = "form-control Numeric", id = "Due", @readonly = true })</td>
                            </tr>
                            <tr>
                                <th>Payment Method</th>
                                <td> @Html.DropDownList("PaymentMethodId", ViewBag.PaymentMethodList as IEnumerable<SelectListItem>, "Select", new { @class = "form-control form-filter input-sm", required = "Required" })</td>
                            </tr>
                            <tr class="bankInfo" style="display:none">
                                <th>Bank Name</th>
                                <td> @Html.DropDownList("BankId", ViewBag.BankList as IEnumerable<SelectListItem>, "Select", new { @class = "form-control form-filter input-sm" })</td>
                            </tr>
                            <tr class="bankInfo" style="display:none">
                                <th>Check No</th>
                                <td>@Html.TextBox("CheckNo", null, new { @class = "form-control Numeric", placeholder = "Enter Check Number" })</td>
                            </tr>
                            <tr class="bankInfo" style="display:none">
                                <th>Check Date</th>
                                <td>@Html.TextBox("CheckDate", null, new { @class = "form-control datepicker", placeholder = "Enter Check Date" })</td>
                            </tr>
                            <tr>
                                <th>Payment Date</th>
                                <td>@Html.TextBox("PaymentDate", null, "{0:mm/dd/yyyy}", new { @class = "form-control datepicker", required = "Required" })</td>
                            </tr>

                            <tr>
                                <td colspan="2" style="padding-left:40%"><input type="submit" value="Save" id="btnStdPayment" class="btn btn-success" /></td>
                            </tr>
                        </table>



                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section scripts{

    <script>
        $('#noMonth').multiselect();
        $("#noMonth").on('change', function () {
            var sel = $("#noMonth").val();
            $.each(sel, function (key, value) {
                var myIndex = key + 1;
                var mTotal = 0;
                mTotal = myIndex * parseInt($('#txt_1').val());
                $('#MonthlyFeesToPay').val(mTotal);
            });

        });

        $(function () {
            $("#PaymentDate").datepicker(
                {
                    dateFormat: 'dd/mm/yyyy',
                    changeMonth: true,
                    changeYear: true
                });
        });

        $('#PaymentMethodId').change(function () {
            var optionSelected = $(this).find("option:selected");
            var valueSelected = optionSelected.val();
            if (valueSelected == 1) {
                $(".bankInfo").hide();
            }
            else {
                $(".bankInfo").show();
            }
        });

        var total = 0;
        $('input:checkbox').on('change', function () {
            var sum = 0;


            $('.check').each(function (i) {
                if ($("#chk_" + i).is(":checked")) {
                    if (i == 1)
                        sum = sum + parseFloat($("#MonthlyFeesToPay").val());
                    else
                        sum = sum + parseFloat($("#txt_" + i).val());

                }


            });

            $("#TotalAmount").val(sum.toFixed(2));
            $("#TotalSemesterFees").val(sum.toFixed(2));
            total = sum;


        });

        $('.InvQty').keyup(function () {

            var due = 0;
            var val2 = 0;
            $("input[id^='InvQty']").each(function () {
                if ($(this).val().length != 0) {
                    val2 = val2 + parseFloat($(this).val())  // need to parse int and float avoiding NaN
                    due = total - val2;
                }
            });

            $('#Due').val(due.toFixed(2));
        });

    </script>
  


