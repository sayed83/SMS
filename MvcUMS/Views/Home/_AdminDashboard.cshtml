                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="@Url.Action("SubjectMark", "Result")"><i class="icon-add-to-list"></i> Number Distribution</a></li>
                    <li class="divider"></li>
                    <li><a href="@Url.Action("ShowResult", "Result")"><i class="icon-list3"></i> Generate Marksheet</a></li>
