<div class="row">
    <div class="col-md-4">
        <div class="panel panel-body border-top-primary text-center">
            <div class="btn-group">
                <button type="button" class="btn bg-teal-400 btn-labeled dropdown-toggle" data-toggle="dropdown"><b><i class="icon-reading"></i></b> Student <span class="caret"></span></button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="@Url.Action("Student_entry", "Home")"><i class="icon-enter"></i> Student Admission</a></li>
                    <li class="divider"></li>
                    <li><a href="@Url.Action("Student_list", "Home")"><i class="icon-list"></i> Student List</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-body border-top-primary text-center">
            <div class="btn-group">
                <button type="button" class="btn bg-purple-300 btn-labeled dropdown-toggle" data-toggle="dropdown"><b><i class="icon-reading"></i></b> Teacher&Stuff <span class="caret"></span></button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="@Url.Action("Create", "Stuff")"><i class="icon-enter"></i> New Employee Entry</a></li>
                    <li class="divider"></li>
                    <li><a href="@Url.Action("Index", "Stuff")"><i class="icon-list"></i> Employee List</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-body border-top-primary text-center">
            <div class="btn-group">
                <button type="button" class="btn bg-blue-400 btn-labeled dropdown-toggle" data-toggle="dropdown"><b><i class="icon-reading"></i></b> Attendance <span class="caret"></span></button>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li><a href="@Url.Action("std_attendence", "Home")"><i class="icon-enter"></i> Manual Attendance</a></li>
                    <li><a href="@Url.Action("ManualAttendenceSearch", "Home")"><i class="icon-enter3"></i> Search Manual Attendance</a></li>
                    <li class="divider"></li>
                    <li><a href="@Url.Action("showAttendence", "Home")"><i class="icon-accessibility"></i> Search Attendance</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-body border-top-primary text-center">
