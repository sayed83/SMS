@model MvcUMS.Models.ExamType

@{
    ViewBag.Title = "Exam Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("Examtype", "Common", FormMethod.Post, new
        {

            @class = "form-horizontal",
            id = "submitForm"
        }))
        {

            <div class="panel panel-white">
                <div class="panel-heading">
                    <h2 class="panel-title">Exam Name</h2>
                </div>

                <div class="panel-body">
                    <span class="error-info text-semibold">@TempData["error"]</span>
                    <div class="form-group">
                        <label class="col-lg-4 control-label">Exam Type:</label>
                        <div class="col-lg-8">
                            @Html.TextBoxFor(model => model.Examtype, new { @class = "form-control", id = "corsetitle", placeholder = "Exam type" })
                            @Html.ValidationMessageFor(model => model.Examtype)
                        </div>
                    </div>
                    <div class="text-right">
                        <button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>

@{
    Html.RenderAction("ExamList", "Common");
}

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
}
