@model MvcUMS.Models.Expancetype

@{
    ViewBag.Title = "Common";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("Expacncetype", "Common", FormMethod.Post, new
        {

            @class = "form-horizontal",
            id = "submitForm"
        }))
        {
            @Html.ValidationSummary(true)
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h5 class="panel-title">Expense Type</h5>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>




                    <div class="form-group">
                        <label class="col-lg-3 control-label">Expense Title:</label>
                        <div class="col-lg-9">
                            @Html.TextBoxFor(model => model.TypeName, new { @class = "form-control", id = "corsetitle", placeholder = "Type Name" })
                            @Html.ValidationMessageFor(model => model.TypeName)
                        </div>
                    </div>




                    <div class="text-right">
                        <div class="btn-group">
                            <a href="@Url.Action("ExpenseList","Common")" class="btn bg-slate-700">Expense List</a>
                            @*<button type="submit" id="btnExpenseList" class="btn bg-slate-700"><strong>Expense List</strong> <i class="icon-arrow-right14 position-right"></i></button>*@
                            <button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>

                        </div>
                        @*<button type="submit" id="btncreate" name="Command" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>*@
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>




@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
}
