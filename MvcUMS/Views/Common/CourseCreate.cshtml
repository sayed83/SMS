@model MvcUMS.Models.Course

@{
    ViewBag.Title = "Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />
<link href="~/Content/CSS/autocomplete.css" rel="stylesheet" />

<style>
   #Department, #Semester, #corsetitle, #corseid {
        width: 90%;
        height: 30px;
    }
</style>
<br />
<h1 style="text-align:center"> Course Details</h1>
<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6 well">
        @using (Html.BeginForm("CourseCreate", "Common", FormMethod.Post, new { id = "submitForm" }))
        {
            <table class="table table-bordered table-condensed table-hover">

                <tr class="info">
                    <td><b>Class</b></td>
                    <td><b>:</b></td>
                    <td>@Html.DropDownList("Semester", null, "Select", new { @class = "form-control" })</td>
                </tr>
                <tr class="danger" id="group" style="display:none">
                    <td><b>Group</b></td>
                    <td><b>:</b></td>
                    <td>@Html.DropDownList("Department", null, "Select", new { @class = "form-control" })</td>
                </tr>
              
                <tr class="success">
                    <td><b>Course Title</b></td>
                    <td><b>:</b></td>
                    <td>
                        @Html.TextBoxFor(model => model.CourseTitle, new { @class = "form-control", id = "corsetitle", placeholder = "Course Name" })

                        <p style="color:red">  @Html.ValidationMessageFor(model => model.CourseTitle) </p>
                    </td>
                  <tr class="success">
                    <td><b>Course Code</b></td>
                    <td><b>:</b></td>
                    <td>
                        @Html.TextBoxFor(model => model.CourseId, new { @class = "form-control", id = "corseid", placeholder = "Course Code" })
                        <p style="color:red">  @Html.ValidationMessageFor(model => model.CourseId) </p>
                       
                    </td>
                </tr>
                <tr class="info">
                    <td style="text-align:left"><input type="submit" id="btnsearch" name="Command" class="btn btn-success" value="Search" /></td>
                    <td></td>
                    <td><input type="submit" id="btncreate" name="Command" class="btn btn-success" value="Create" /></td>
                </tr>
            </table>
           
           <p style="color:red"> @TempData["error"]</p>
        }
      
    </div>
</div>
 
       <div class="row">

        <div class="col-md-12">
        @{
            
            Html.RenderAction("CourseList", "Common", new { Department = TempData["Department"], Semester = TempData["Semester"] });
        }
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery-ui-1.8.24.js"></script>
    <script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>
    <script src="~/Scripts/combodate.js"></script>
    <script src="~/Scripts/jquery-1.8.1.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/jquery-1.7.1.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/jquery-ui-1.8.20.min.js")" type="text/javascript"></script>

    <script type="text/javascript">
        $(function () {
            $('#Semester').change(function () {

                var s = $('#Semester').val();
                if (s == 'Nine' || s == 'Ten' || s == 'Eleven' || s == 'Twelve') {
                    $('#group').show();
                }
                else {
                    $('#group').hide();
                }

            });

        });
</script>
    <script type="text/javascript">
        $(function () {
            $("#ADMtext-box,#DBTxt-box,#dobbox,#joindatetext-box").datepicker(
                {
                    dateFormat: 'yy/mm/dd',
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "-30:+5"
                });
        });
    </script>

    <script type="text/javascript">
        $(function () {

            $('#prize').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;

                else if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });
            $('#bookcopy').keypress(function (event) {

                if (event.which == 8 || event.keyCode == 37 || event.keyCode == 39 || event.keyCode == 46)
                    return true;

                else if (event.which != 46 && (event.which < 48 || event.which > 57))
                    event.preventDefault();

            });


        });


    </script>

    <script type="text/javascript">

    $(document).ready(function () {

        $("#catagory").change(function () {
            if ($("#catagory option:selected").val() == '')
            {
                $("#Auther").empty();
                return false;
            }
            else {
                //$("#city").empty();

                $.ajax({

                    type: 'POST',

                    url: '@Url.Action("GetAuther", "Library")',

                    dataType: 'json',

                    data: { id: $("#catagory").val() },

                    success: function (Data) {

                        var markup = "<option value='0'>Select Auther</option>";
                        for (var x = 0; x < Data.length; x++) {
                            markup += "<option Value='" + Data[x].Value + "'>" + Data[x].Text + "</option>";
                        }

                        $("#Auther").html(markup).show();

                    },

                    error: function (ex) {

                        alert('Failed to retrieve Autheir.' + ex);

                    }

                });
            }

        });

    });

    </script>

    @Scripts.Render("~/bundles/jqueryval")
}
