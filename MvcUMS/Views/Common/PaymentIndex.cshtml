@model IEnumerable<MvcUMS.Models.ViewModels.StudentPaymentAmountViewModel>

@{
    ViewBag.Title = "Payment Amount Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Payment Type List <span style="text-align:right"> @Html.ActionLink("Create New", "PaymentCreate", null, new { @class = "btn btn-success pull-right" })</span>
        </h5>
    </div>
    <table class="table datatable-button-print-basic table-striped" id="paymentList">
        <thead>
            <tr class="table_header">
                <th>Class</th>
                <th>Payment Type</th>
                <th>Amount</th>
                <th class="noExport">Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.Semester)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Amount)
                    </td>
                    <td>
                        <ul class="icons-list">
                            <li><a href='@Url.Action("PayAmountEdit", "Common", new { id=item.Id })' class="btn btn-xs"><i class="icon-pencil7"></i></a></li>
                            <li>
                                <a href="@Url.Action("PaymentDelete", "Common", new { id = item.Id })" class="btn btn-xs btn-dange" onclick="return confirm('Are you want to delete?');"><i class="icon-trash"></i></a>
                            </li>

                        </ul>

                    </td>
                </tr>
            }
        </tbody>
    </table>


</div>

@section scripts{

    <script>
        $(function () {

            $('.datatable-button-print-basic').DataTable({

                buttons: [
                    {
                        extend: 'print',
                        text: '<i class="icon-printer position-left"></i> Print table',
                        className: 'btn bg-blue',
                        title: 'Payment Type List',
                        customize: function (win) {

                            $(win.document.body)
                                .css('font-size', '10pt')
                                .prepend(
                                    '<img src="~/Content/dashboard_template/assets/images/global-soft.-2.jpg" style="position:absolute; top:0; left:0;" />'
                                );

                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', 'inherit');
                        },
                        exportOptions: {
                            columns: "thead th:not(.noExport)"
                        }
                    }
                ]
            });


        });
    </script>
}