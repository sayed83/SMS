@model MvcUMS.Models.ScholarshipType


@{
    ViewBag.Title = "Scolarship";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
@*<link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />*@
@*<link href="~/Content/CSS/autocomplete.css" rel="stylesheet" />*@


<div class="row">
    <div class="col-md-offset-3 col-md-6">

        <!-- Basic layout-->
        @using (Html.BeginForm("ScolarShipType", "Common", FormMethod.Post, new
        {

            @class = "form-horizontal"
        }))
        {
           
            <div class="panel panel-white">
                <div class="panel-heading">
                    <h2 class="panel-title">Expense Type</h2>
                </div>

                <div class="panel-body">


                    @*<button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>*@
                    <span class="error-info text-semibold">@TempData["error"]</span>




                    <div class="form-group">
                        <label class="col-lg-4 control-label">Scholarship type:</label>
                        <div class="col-lg-8">
                            @Html.TextBoxFor(model => model.TypeName, new { @class = "form-control", placeholder = "Scolarship Type", id = "text-box" })
                            @Html.ValidationMessageFor(model => model.TypeName)
                        </div>
                    </div>




                    <div class="text-right">

                        <button type="submit" class="btn bg-slate-700"><strong>Create</strong> <i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        }
        <!-- /basic layout -->

    </div>
</div>





@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
