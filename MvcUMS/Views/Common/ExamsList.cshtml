@using PagedList.Mvc;
@using PagedList;
@model PagedList.IPagedList<MvcUMS.Models.ExamAndType>

@{
    Layout = null;

}

<style>

    .table > thead > tr > th, .table > tbody > tr > th,
    .table > tfoot > tr > th, .table > thead > tr > td,
    .table > tbody > tr > td, .table > tfoot > tr > td {
        padding: 12px 21px !important;
    }
</style>


<!-- Bordered table -->



<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Exam List
        </h5>

    </div>


    <table class="table datatable-basic table-bordered">
        <thead>
            <tr>
                <th>Exam Type</th>
                <th>Exam Date</th>
                <th>Type</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Course Id</th>
                <th>Course Name</th>
                <th>Teacher</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align:center">
                        @item.et.Examtype
                    </td>
                    <td style="text-align:center">
                        @item.ex.Date.ToShortDateString()
                    </td>
                    <td style="text-align:center">
                        @item.ex.Type
                    </td>
                    <td style="text-align:center">
                        @item.ex.StartTime
                    </td>
                    <td style="text-align:center">
                        @item.ex.EndTime
                    </td>
                    <td style="text-align:center">
                        @item.ex.CourseId
                    </td>
                    <td style="text-align:center">
                        @item.co.CourseTitle
                    </td>
                    <td style="text-align:center">
                        @item.stuff.FirstName  @item.stuff.LastName
                    </td>
                    <td style="text-align:left">
                        @*@Html.ActionLink("Details", "DetailExam", new { id = item.ex.Id }, new { @class = "detailDialog btn btn-info" })|
                            @Html.ActionLink("Edit", "ExamEdit", new { id = item.ex.Id }, new { @class = "editDialog btn btn-info" })|*@

                        <a href="@Url.Action("ExamEdit", "Common", new { id = item.ex.Id })" class="btn btn-default" data-toggle="modal" data-target="#EditDialog">
                            <i class="icon-pencil5"></i>
                            @*<span>
                                    <strong>Edit</strong>
                                </span>*@
                        </a>

                        <a href="@Url.Action("DetailExam", "Common", new { id = item.ex.Id })" class="btn btn-default" data-toggle="modal" data-target="#DetailsDialog ">

                            <i class="icon-grid"></i>
                            @*<span>
                                    <strong>Details</strong>
                                </span>*@
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div id="container" style="margin-left: 20px">     
        <div class="pagination" style="margin-left: 400px">
            @*Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount*@
           
                showing @Model.FirstItemOnPage to @Model.LastItemOnPage of @Model.TotalItemCount Records
            
            
                @Html.PagedListPager(Model, Page_No => Url.Action("Exam", new { Page_No, page = Model.PageNumber }))
           

        </div>    
    </div>  

</div>


<!-- Basic modal -->
<div id="EditDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>

    </div>
</div>
<!-- /basic modal -->
<!-- Basic modal -->
<div id="DetailsDialog" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>

    </div>
</div>
<!-- /basic modal -->

@section Scripts {

    <script src="/Scripts/jquery-1.8.2.js"></script>

    @*<script src="~/Scripts/jquery-ui-1.8.24.js"></script>
        <script src="~/Scripts/jquery-ui-1.8.18.custom.min.js"></script>
        <script src="~/Scripts/combodate.js"></script>
        <script src="~/Scripts/jquery-1.8.1.js" type="text/javascript"></script>
        <script src="~/Scripts/jquery-1.8.1.min.js" type="text/javascript"></script>*@

    <script type="text/javascript">

        $(document).ready(function () {
            $('.datatable-basic').DataTable({
                "paging": false
            });
            

        });

    </script>




}


