@model MvcUMS.Models.Bank
@{
    Layout = null;
}

<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">Edit Bank</h5>
    </div>

    <div class="panel-body">

        @using (Html.BeginForm("BankEdit", "Common", FormMethod.Post, new
                        {
                            @class = "form-horizontal"
                        }))
        {
            <div class="form-group">
                <label class="col-lg-4 control-label">Bank Name:</label>
                <div class="col-lg-8">
                    @Html.TextBoxFor(m => m.BankName, null, new { @class = "form-control",required = true })
                </div>
            </div>

            <div class="form-group">
                <label class="col-lg-4 control-label">Account No:</label>
                <div class="col-lg-8">
                    @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control", required = true })
                </div>
            </div>
            
            <div class="form-group">
                <label class="col-lg-4 control-label">Amount:</label>
                <div class="col-lg-8">
                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", required = true })
                </div>
            </div>

            @Html.HiddenFor(model => model.Id)
            <div class="text-right">
                <button type="submit" id="btnSubmit" name="Command" class="btn bg-slate-700"><strong>Update</strong> <i class="icon-arrow-right14 position-right"></i></button>
            </div>

        }
    </div>
</div>
