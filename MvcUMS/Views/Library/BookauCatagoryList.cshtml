@model PagedList.IPagedList<MvcUMS.Models.cataauther>
@using PagedList.Mvc;
@using PagedList;
@{
    Layout = null;
}



<style>
    .dataTables_length {
        float: right;
        display: inline-block;
        margin: 15px 20px 20px 20px !important;
    }

    .dataTables_filter {
        position: relative;
        display: block;
        float: left;
        margin: 15px 0 20px 20px !important;
    }

    .dataTables_info {
        float: left;
        padding: 8px 20px !important;
        margin-bottom: 20px;
    }

    .panel > .dataTables_wrapper .table-bordered {
        border-top: 1px solid #ddd !important;
        border-bottom: 1px solid #ddd !important;
        margin-bottom: 10px!important;
    }


    .dataTables_filter input {
        margin-left: 8px;
    }
</style>


<div class="panel panel-white">
    <div class="panel-heading">
        <h5 class="panel-title">
            Mark Details
        </h5>

    </div>

     <table class="table table-striped table-bordered" id="AuthorByCategory">
            <thead>
                <tr>
                    <th>Catagory Name</th>
                    <th>Auther Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align:center">
                            @item.catagoryname
                        </td>
                        <td style="text-align:center">
                            @item.authername
                        </td>

                    </tr>
                }
            </tbody>
        </table>

</div>

